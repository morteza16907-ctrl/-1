<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="طلافروشی">
<title>طلافروشی</title>
<style>
/* فونت Vazirmatn embed شده — کاملاً آفلاین */
@font-face{font-family:'V';src:local('Vazirmatn'),local('Tahoma');font-weight:400}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{background:#0d0d0d;color:#eee;font-family:Vazirmatn,Tahoma,Arial,sans-serif;direction:rtl;min-height:100vh}
input,select,button{font-family:inherit;font-size:14px}
.inp{background:#1a1a1a;border:1px solid #2a2a2a;color:#eee;border-radius:8px;padding:11px 12px;width:100%;outline:none;-webkit-appearance:none;appearance:none}
.inp:focus{border-color:#c9a84c88}
label{color:#777;font-size:12px;margin-bottom:4px;display:block}
.card{background:#141414;border:1px solid #2a2a2a;border-radius:12px;padding:14px;margin-bottom:10px}
.row{display:flex;gap:8px;align-items:center}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.s2{grid-column:span 2}
.stat{background:#1a1a1a;border-radius:10px;padding:11px 13px;flex:1;min-width:80px}
.badge{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;display:inline-block}
.tabs{display:flex;gap:2px;padding:8px 10px;border-bottom:1px solid #2a2a2a;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{background:transparent;color:#777;border:none;padding:8px 11px;border-radius:8px;cursor:pointer;font-weight:700;font-size:11px;white-space:nowrap;font-family:inherit}
.tab.on{background:#c9a84c;color:#000}
.btn{border:none;border-radius:8px;padding:9px 14px;cursor:pointer;font-weight:700;font-size:12px;font-family:inherit}
.bgold{background:#c9a84c;color:#000;width:100%;padding:13px;font-size:15px;border-radius:10px;margin-top:12px;border:none;cursor:pointer;font-weight:800;font-family:inherit}
.bgold:disabled{background:#2a2a2a;color:#444;cursor:not-allowed}
.mini{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:5px;margin-bottom:8px}
.mc{background:#1a1a1a;border-radius:6px;padding:4px 6px}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.tag{color:#444;font-size:11px}
.drop{position:absolute;top:100%;right:0;left:0;background:#222;border:1px solid #333;border-radius:8px;z-index:99;max-height:180px;overflow-y:auto;margin-top:2px;box-shadow:0 4px 12px #000a}
.di{padding:10px 12px;border-bottom:1px solid #2a2a2a;font-size:13px;cursor:pointer}
.di:active{background:#333}
.pbox{background:#0a1a0a;border:1px solid #c9a84c33;border-radius:10px;padding:12px;margin-top:12px}
.pr{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid #1a2a1a;font-size:12px}
.empty{color:#333;text-align:center;padding:40px}
.modal-bg{position:fixed;inset:0;background:#000c;z-index:100;display:flex;align-items:flex-end;justify-content:center}
.modal{background:#141414;border-top:1px solid #2a2a2a;border-radius:16px 16px 0 0;padding:20px;width:100%;max-width:500px;max-height:90vh;overflow-y:auto}
.stitle{color:#c9a84c;font-weight:700;font-size:13px;margin-bottom:10px}
.tx-row{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid #1a1a1a}
.filt{border:1px solid #2a2a2a;background:#1a1a1a;color:#777;border-radius:20px;padding:5px 12px;font-size:12px;cursor:pointer;white-space:nowrap;font-family:inherit}
.filt.on{background:#c9a84c22;border-color:#c9a84c88;color:#c9a84c}

</style>
</head>
<body>
<body>
<div id="hdr"></div>
<div class="tabs" id="tabs"></div>

<!-- فرم ثبت — یک‌بار ساخته میشه -->
<div id="pg-new" style="display:none;padding:12px;max-width:700px;margin:0 auto;padding-bottom:40px">
  <div class="card">
    <div class="stitle">🏷️ جستجوی سریع محصول</div>
    <div style="position:relative">
      <input id="quick-inp" class="inp" placeholder="کد یا نام محصول...">
      <div id="quick-drop"></div>
    </div>
    <div id="sel-prod" style="display:none;margin-top:10px;background:#1a2a1a;border-radius:8px;padding:10px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div id="sel-name" style="color:#4ade80;font-weight:700;font-size:14px"></div>
        <button onclick="clearProd()" style="background:transparent;color:#f87171;border:none;font-size:20px;cursor:pointer">×</button>
      </div>
      <div id="sel-info" style="color:#888;font-size:11px;margin-top:3px"></div>
    </div>
  </div>
  <div class="card">
    <div class="stitle">🎤 ورودی صوتی / متنی</div>
    <div class="row" style="margin-bottom:10px">
      <button id="voice-btn" class="btn" onclick="startVoice()" style="flex:1;background:#1a2a1a;color:#4ade80">🎙️ ضبط صدا</button>
      <button id="ai-btn" class="btn" onclick="doAI()" style="flex:1;background:#1a1a2a;color:#60a5fa">🤖 تحلیل AI</button>
    </div>
    <input id="tr-inp" class="inp" placeholder="یا تایپ کنید...">
    <div id="ai-err" style="display:none;color:#f87171;font-size:11px;margin-top:6px"></div>
  </div>
  <div class="card">
    <div class="row" style="margin-bottom:14px;flex-wrap:wrap;gap:6px">
      <button class="btn type-btn" data-v="sell" onclick="setType('sell')" style="flex:1;min-width:70px">فروش</button>
      <button class="btn type-btn" data-v="buy" onclick="setType('buy')" style="flex:1;min-width:70px">خرید طلا</button>
      <button class="btn type-btn" data-v="service" onclick="setType('service')" style="flex:1;min-width:70px">خدمات</button>
      
    </div>
    <div class="g2">
      <div id="row-item" class="s2">
        <label>نام کالا *</label>
        <input id="f-item" class="inp" placeholder="گردنبند، النگو، انگشتر..." oninput="FORM.item=this.value">
      </div>
      <div id="row-svc" class="s2" style="display:none">
        <label>نوع خدمت *</label>
        <select id="f-svc" class="inp" onchange="onSvcChange(this.value)">
          <option value="">انتخاب کنید...</option>
          <option>تعمیر و لحیم‌کاری</option><option>تغییر سایز</option>
          <option>پولیش و تمیزکاری</option><option>نگین‌کاری</option>
          <option>آب‌طلا</option><option>حکاکی</option><option value="__o">سایر</option>
        </select>
        <input id="f-svc-o" class="inp" style="display:none;margin-top:6px" placeholder="نوع خدمت..." oninput="FORM.item=this.value">
      </div>
      <div class="s2" style="position:relative">
        <label>نام مشتری</label>
        <input id="f-cust" class="inp" placeholder="نام مشتری..." oninput="FORM.cust=this.value;showCustDrop()">
        <div id="cust-drop"></div>
      </div>
      <div class="s2">
        <label>شماره تماس</label>
        <input id="f-phone" class="inp" placeholder="۰۹۱۲..." oninput="FORM.phone=this.value">
      </div>
      <div id="gf" style="display:contents">
        <div><label>وزن (گرم)</label><input id="f-w" class="inp" type="number" inputmode="decimal" placeholder="5.2" oninput="FORM.weight=this.value;liveCalc()"></div>
        <div><label>عیار</label>
          <select id="f-karat" class="inp" onchange="FORM.karat=this.value">
            <option value="18">18</option><option value="21">21</option><option value="22">22</option><option value="24">24</option>
          </select>
        </div>
        <div id="wpv-fields" style="display:contents">
          <div><label id="wp-label">اجرت فروش %</label><input id="f-wp" class="inp" type="number" inputmode="decimal" value="10" oninput="FORM.wp=this.value;liveCalc()"></div>
          <div><label>سود %</label><input id="f-pp" class="inp" type="number" inputmode="decimal" value="7" oninput="FORM.pp=this.value;liveCalc()"></div>
          <div><label>مالیات %</label><input id="f-vp" class="inp" type="number" inputmode="decimal" value="10" oninput="FORM.vp=this.value;liveCalc()"></div>
        </div>
        <div class="s2"><label>قیمت هر گرم (تومان)</label><div style="display:flex;gap:6px"><input id="f-ppg" class="inp" type="text" inputmode="numeric" placeholder="16,148,000" oninput="FORM.ppg=fmtInputLive(this);liveCalc()" style="flex:1"><button type="button" onclick="fetchLivePriceIntoForm()" style="background:#1a2a3a;color:#60a5fa;border:1px solid #60a5fa44;border-radius:8px;padding:0 12px;white-space:nowrap;cursor:pointer;font-family:inherit;font-size:12px">🔄 لحظه‌ای</button></div></div>
        <div class="s2"><label id="paid-label">پرداخت شده (تومان)</label><input id="f-paid" class="inp" type="text" inputmode="numeric" placeholder="0 = نسیه کامل" oninput="FORM.paid=fmtInputLive(this);liveCalc()"></div>
        <div id="pw-field" class="s2" style="display:none">
          <label id="pw-label">وزن پرداخت‌شده (گرم)</label>
          <input id="f-paid-weight" class="inp" type="number" inputmode="decimal" placeholder="خالی = کل وزن تسویه شده" oninput="FORM.paidWeight=this.value;liveCalc()">
        </div>
        <div class="s2">
          <label id="bank-acc-label">🏦 واریز به کدام حساب</label>
          <select id="f-bank-acc" class="inp" onchange="FORM.bankAccountId=this.value">
            <option value="">— ثبت نشود —</option>
          </select>
        </div>
      </div>
      <div id="acc-fields" style="display:none;grid-column:span 2">
        <div class="stitle" style="margin-bottom:8px">🔗 متعلقات (چرم، سنگ، مهره، بند و...)</div>
        <div id="acc-list"></div>
        <div class="row" style="margin-top:6px;gap:6px">
          <button type="button" onclick="addAccessoryRow()" style="background:#1a2a3a;color:#60a5fa;border:1px solid #60a5fa44;border-radius:8px;padding:8px 14px;font-size:12px;cursor:pointer;font-family:inherit">+ متعلق دستی</button>
          <button type="button" onclick="openAccCatalogPicker()" style="background:#1a2a1a;color:#4ade80;border:1px solid #4ade8044;border-radius:8px;padding:8px 14px;font-size:12px;cursor:pointer;font-family:inherit">📋 انتخاب از کاتالوگ</button>
        </div>
      </div>
      <div id="sf" style="display:none;grid-column:span 2">
        <label>هزینه خدمت (تومان)</label>
        <input id="f-sfee" class="inp" type="text" inputmode="numeric" placeholder="500,000" oninput="FORM.sfee=fmtInputLive(this)">
      </div>
      <div id="sgf" style="display:none;contents">
        <div><label>وزن تحویلی (گرم)</label><input id="f-pgram" class="inp" type="number" inputmode="decimal" placeholder="اختیاری" oninput="FORM.paidGram=this.value"></div>
      </div>
      <div class="s2"><label>یادداشت</label><input id="f-note" class="inp" placeholder="توضیحات..." oninput="FORM.note=this.value"></div>
    </div>
    <div id="price-box" class="pbox" style="display:none">
      <div class="stitle">📊 محاسبه قیمت</div>
      <div class="pr"><span style="color:#666">ارزش طلا</span><span id="pc-gv" style="color:#eee;font-weight:600"></span></div>
      <div id="pc-wpv-rows">
        <div class="pr"><span style="color:#666">اجرت ساخت</span><span id="pc-w" style="color:#a78bfa;font-weight:600"></span></div>
        <div class="pr"><span style="color:#666">سود فروشنده</span><span id="pc-p" style="color:#60a5fa;font-weight:600"></span></div>
        <div class="pr"><span style="color:#666">مالیات</span><span id="pc-v" style="color:#fb923c;font-weight:600"></span></div>
      </div>
      <div id="pc-acc-row" style="display:none" class="pr"><span style="color:#666">🔗 متعلقات</span><span id="pc-acc" style="color:#f0abfc;font-weight:600"></span></div>
      <div class="pr"><span style="color:#666">جمع کل</span><span id="pc-tot" style="color:#c9a84c;font-weight:800;font-size:14px"></span></div>
      <div class="pr"><span style="color:#666">پرداخت شده</span><span id="pc-paid" style="color:#4ade80;font-weight:600"></span></div>
      <div id="pc-paid-warn" style="display:none;background:#3a2a0a;color:#fbbf24;font-size:11px;border-radius:6px;padding:6px 8px;margin:4px 0">⚠️ عدد پرداختی خیلی بزرگ‌تر از جمع کله — دوباره چک کن اشتباهی رقم اضافه نزده باشی</div>
      <div style="display:flex;justify-content:space-between;padding-top:8px">
        <span style="color:#f87171;font-weight:800;font-size:13px">مانده</span>
        <span id="pc-bal" style="color:#f87171;font-weight:800;font-size:15px"></span>
      </div>
      <div id="pc-wbal-row" style="display:none;justify-content:space-between;padding-top:6px">
        <span id="pc-wbal-label" style="color:#60a5fa;font-weight:800;font-size:13px">مانده وزن</span>
        <span id="pc-wbal" style="color:#60a5fa;font-weight:800;font-size:15px"></span>
      </div>
    </div>
    <button id="sub-btn" class="bgold" onclick="submitTx()">✓ ثبت</button>
  </div>
</div>

<div id="pg-other" style="padding:12px;max-width:700px;margin:0 auto;padding-bottom:40px"></div>
<div id="modal-cont"></div>
<script>
// ══ تاریخ شمسی ═══════════════════════════════════════════════════════
function toJalali(date){
  const d=date||new Date();
  try{
    const p=new Intl.DateTimeFormat('fa-IR-u-ca-persian',{year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(d);
    const n=s=>s.replace(/[۰-۹]/g,c=>String(c.charCodeAt(0)-1776));
    const g=t=>+n(p.find(x=>x.type===t)?.value||'0');
    return{y:g('year'),m:g('month'),d:g('day')};
  }catch{return{y:d.getFullYear()-621,m:d.getMonth()+1,d:d.getDate()};}
}
function jStr(d){const j=toJalali(d);return`${j.y}/${String(j.m).padStart(2,'0')}/${String(j.d).padStart(2,'0')}`;}
function jMonth(m){return['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'][m-1]||'';}
function jCmp(a,b){if(!a||!b)return 0;const pa=a.split('/').map(Number),pb=b.split('/').map(Number);for(let i=0;i<3;i++)if(pa[i]!==pb[i])return pa[i]-pb[i];return 0;}
function today(){return jStr();}

// ══ داده ════════════════════════════════════════════════════════════════
const SK='gold_v6';
function initDB(){return{tx:[],inv:[],cust:[],products:[],coinInv:[],accessoryCatalog:[],bankAccounts:[]};}
let DB=(()=>{try{const d=JSON.parse(localStorage.getItem(SK))||initDB();if(!d.coinInv)d.coinInv=[];if(!d.accessoryCatalog)d.accessoryCatalog=[];if(!d.bankAccounts)d.bankAccounts=[];return d;}catch{return initDB();}})();
function save(){
  try{
    localStorage.setItem(SK,JSON.stringify(DB));
    autoBackup();
  }catch{}
}

// پشتیبان خودکار — بعد از هر ثبت، یه نسخه امن جدا ذخیره میشه
const AUTO_BACKUP_KEY = 'gold_v6_autobackup';
const AUTO_BACKUP_HISTORY_KEY = 'gold_v6_backup_history';
function autoBackup(){
  try{
    const snapshot = {
      date: new Date().toISOString(),
      jdate: today(),
      db: DB
    };
    localStorage.setItem(AUTO_BACKUP_KEY, JSON.stringify(snapshot));
    // نگهداری چند نسخه آخر (حداکثر 5 تا) برای بازیابی از نسخه‌های قدیمی‌تر
    let history = [];
    try{ history = JSON.parse(localStorage.getItem(AUTO_BACKUP_HISTORY_KEY)||'[]'); }catch{}
    history.unshift(snapshot);
    if(history.length > 5) history = history.slice(0,5);
    localStorage.setItem(AUTO_BACKUP_HISTORY_KEY, JSON.stringify(history));
  }catch(e){
    // اگه localStorage پر بود، این خطا نباید کل ذخیره‌سازی اصلی رو خراب کنه
    console.warn('Auto-backup failed:', e);
  }
}

function restoreFromAutoBackup(){
  try{
    const snap = JSON.parse(localStorage.getItem(AUTO_BACKUP_KEY));
    if(!snap || !snap.db){ alert('نسخه پشتیبان خودکار یافت نشد'); return; }
    if(!confirm(`بازیابی از آخرین نسخه خودکار (${snap.jdate})؟\nتراکنش‌ها: ${snap.db.tx?.length||0}`)) return;
    DB = {
      tx:snap.db.tx||[], inv:snap.db.inv||[], cust:snap.db.cust||[], products:snap.db.products||[],
      coinInv:snap.db.coinInv||[], accessoryCatalog:snap.db.accessoryCatalog||[], bankAccounts:snap.db.bankAccounts||[]
    };
    localStorage.setItem(SK, JSON.stringify(DB));
    alert('بازیابی موفق ✅');
    closeModal(); TAB='dashboard'; showTab();
  }catch(e){ alert('خطا در بازیابی: '+e.message); }
}

// حذف کامل همه‌ی اطلاعات و شروع مجدد از صفر
function clearAllData(){
  if(!confirm('⚠️ مطمئنی؟\nهمه‌ی تراکنش‌ها، مشتری‌ها، محصولات، حساب‌های بانکی و کاتالوگ‌ها برای همیشه پاک می‌شن.\n(پیشنهاد میشه قبلش از دکمه «دانلود فایل پشتیبان» یه بک‌آپ بگیری)')) return;
  if(!confirm('برای اطمینان کامل، یه بار دیگه تأیید کن: همه‌چیز پاک بشه؟')) return;
  DB = initDB();
  localStorage.setItem(SK, JSON.stringify(DB));
  localStorage.removeItem(AUTO_BACKUP_KEY);
  localStorage.removeItem(AUTO_BACKUP_HISTORY_KEY);
  alert('همه‌ی اطلاعات پاک شد ✅ — از صفر شروع کن');
  closeModal(); TAB='dashboard'; showTab();
}
let apiKey=localStorage.getItem('gkey')||'';

// ══ state ════════════════════════════════════════════════════════════════
let FORM={type:'sell',item:'',itemCode:'',weight:'',ppg:'',karat:'18',cust:'',phone:'',note:'',wp:'10',pp:'7',vp:'10',sfee:'',paid:'',paidGram:'',accessories:[],buyWp:'',bankAccountId:''};
let TAB='dashboard',MODAL=null,MD={};
let RPT={from:'',to:'',type:'all'};
let SQ={tx:'',cust:'',prod:'',activeCust:null};
let COIN_FORM={type:'buy',coinType:'emami',qty:'1',price:'',cust:'',phone:'',paid:'',note:''};
let SWAP_FORM={
  mode:'coin', // 'coin' یا 'gold'
  // برای معاوضه سکه به سکه:
  giveCoinType:'emami', giveCoinQty:'1', giveCoinPrice:'',
  getCoinType:'bahar', getCoinQty:'1', getCoinPrice:'',
  // برای معاوضه طلای مستعمل به طلای نو:
  giveGoldWeight:'', giveGoldPpg:'',
  getGoldWeight:'', getGoldPpg:'',
  cust:'', phone:'', note:'', settleCash:''
};

// ══ helpers ══════════════════════════════════════════════════════════════
function findInv(item, karat, code) {
  if (code) {
    const byCode = DB.inv.find(i => i.itemCode === code);
    if (byCode) return byCode;
  }
  return DB.inv.find(i => i.item === item && i.karat === karat && !i.itemCode);
}

const _=id=>document.getElementById(id);
function fmt(n){if(!n||n==0)return'—';return Number(n).toLocaleString('fa-IR')+' ت';}

// برای گذاشتن تو value="" اولیه‌ی اینپوت‌ها (بدون "ت"، فقط با ویرگول جداکننده)
function numGroup(n){ if(n===''||n==null) return ''; const s=String(n).replace(/[^\d]/g,''); if(!s) return ''; return s.replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

// موقع تایپ دستی تو فیلدهای مبلغ، هر سه رقم یه ویرگول جدا می‌کنه (فقط برای نمایش)؛ مقدار خام (بدون ویرگول) رو برمی‌گردونه که تو FORM ذخیره بشه
function fmtInputLive(el){
  const posFromEnd = el.value.length - (el.selectionStart||el.value.length);
  const raw = el.value.replace(/[^\d]/g,'');
  if(!raw){ el.value=''; return ''; }
  const formatted = raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  el.value = formatted;
  try{ const pos = Math.max(0, formatted.length - posFromEnd); el.setSelectionRange(pos,pos); }catch(e){}
  return raw;
}
function fmtG(n){if(!n||n==0)return'—';return Number(n).toFixed(3)+' گ';}
function badgeH(t){
  const m={buy:['#1a3a2a','#4ade80','خرید طلا'],sell:['#3a1a1a','#f87171','فروش'],service:['#1a1a3a','#a78bfa','خدمات'],payment:['#2a2a1a','#facc15','پرداخت'],return:['#3a1a2a','#fb7185','مرجوعی'],coinbuy:['#1a3a2a','#4ade80','خرید سکه'],coinsell:['#3a1a1a','#f87171','فروش سکه'],swap:['#2a1a3a','#c084fc','معاوضه'],bankTransfer:['#1a2a3a','#60a5fa','بانک'],thirdPartyTransfer:['#2a1a3a','#c084fc','حواله ثالث']};
  const[bg,c,l]=m[t]||['#222','#888','—'];
  return`<span class="badge" style="background:${bg};color:${c}">${l}</span>`;
}
function statH(label,val,accent){return`<div class="stat" style="border:1px solid ${accent}33"><div style="color:#666;font-size:11px;margin-bottom:3px">${label}</div><div style="color:${accent};font-size:13px;font-weight:800">${val}</div></div>`;}

// ══ محاسبه — فرمول دقیق ═══════════════════════════════════════════════
function calcP(){
  if(!FORM.ppg||!FORM.weight)return null;
  const gv=Math.round((+FORM.ppg)*(+FORM.weight));
  // خرید: فقط بر اساس ارزش طلا — بدون اجرت/سود/مالیات
  if(FORM.type==='buy') return{gv,w:0,p:0,v:0,total:gv,wageDiff:0};
  const w=Math.round(gv*(+FORM.wp||0)/100); // اجرت فروش — همینی که به مشتری نشون داده میشه و توش لحاظ میشه
  // مابه‌التفاوت اجرت خرید از بنکدار و اجرت فروش — فقط برای فروش، بدون تاثیر روی مالیات یا نمایش به مشتری
  const wageDiff = (FORM.type==='sell' && FORM.buyWp!=='' && FORM.buyWp!=null)
    ? Math.round(gv*((+FORM.wp||0)-(+FORM.buyWp||0))/100)
    : 0;
  const p=Math.round((gv+w)*(+FORM.pp||0)/100 + wageDiff); // سود معمولی + مابه‌التفاوت اجرت
  const v=Math.round((w+((gv+w)*(+FORM.pp||0)/100))*(+FORM.vp||0)/100); // مالیات فقط از اجرت + سود معمولی (بدون مابه‌التفاوت)
  return{gv,w,p,v,total:gv+w+p+v,wageDiff};
}
function liveCalc(){
  if(FORM.type==='service'){_('price-box').style.display='none';return;}
  const c=calcP(),box=_('price-box');
  if(!c){box.style.display='none';return;}
  box.style.display='';
  const accTotal = accessoriesTotal();
  const s=(id,v)=>{const el=_(id);if(el)el.textContent=v;};
  const wpvRows=_('pc-wpv-rows');
  if(wpvRows) wpvRows.style.display = FORM.type==='buy' ? 'none' : '';
  s('pc-gv',fmt(c.gv));s('pc-w',fmt(c.w));s('pc-p',fmt(c.p));s('pc-v',fmt(c.v));
  const accRow=_('pc-acc-row');
  if(accRow){
    if(accTotal>0){accRow.style.display='flex';s('pc-acc',fmt(accTotal));}
    else accRow.style.display='none';
  }
  s('pc-tot',fmt(c.total + accTotal));
  s('pc-paid',fmt(+FORM.paid||0));s('pc-bal',fmt(c.total + accTotal - (+FORM.paid||0)));
  // هشدار وقتی عدد پرداختی به‌طرز مشکوکی خیلی بزرگ‌تر از جمع کله (احتمال اشتباه تایپی مثل زدن رقم اضافه)
  const warnEl=_('pc-paid-warn');
  if(warnEl){
    const paidNum=+FORM.paid||0, totNum=c.total+accTotal;
    warnEl.style.display = (totNum>0 && paidNum>totNum*3) ? '' : 'none';
  }
  // مانده وزن (گرم) — فقط وقتی کاربر وزن پرداخت/دریافت‌شده رو کمتر از کل وارد کرده
  const wbalRow=_('pc-wbal-row');
  if(wbalRow){
    const isWeightTx=FORM.type==='buy'||FORM.type==='sell';
    const hasPw=FORM.paidWeight!==''&&FORM.paidWeight!=null;
    const wbal=(+FORM.weight||0)-(hasPw?(+FORM.paidWeight||0):(+FORM.weight||0));
    if(isWeightTx&&hasPw&&wbal!==0){
      wbalRow.style.display='flex';
      _('pc-wbal-label').textContent=FORM.type==='buy'?'طلب مشتری (وزن)':'بدهی مشتری (وزن)';
      _('pc-wbal').textContent=fmtG(Math.abs(wbal));
    }else wbalRow.style.display='none';
  }
}

// ══ متعلقات (چرم، سنگ، مهره و...) — فقط برای فروش ══════════════════════════
function accessoriesTotal(){
  return (FORM.accessories||[]).reduce((a,x)=>a+(+x.price||0),0);
}

function addAccessoryRow(){
  if(!FORM.accessories) FORM.accessories = [];
  FORM.accessories.push({name:'', price:'', buyPrice:0});
  renderAccessoryList();
}

function openAccCatalogPicker(){
  MODAL='pickAcc'; MD=null; renderModal();
}

function pickAccFromCatalog(accId){
  const a = (DB.accessoryCatalog||[]).find(x=>x.id==accId);
  if(!a) return;
  if(!FORM.accessories) FORM.accessories = [];
  FORM.accessories.push({name: a.name, price: String(a.sellPrice||0), buyPrice: +a.buyPrice||0});
  closeModal();
  TAB='new'; showTab();
  renderAccessoryList();
}

function removeAccessoryRow(idx){
  FORM.accessories.splice(idx,1);
  renderAccessoryList();
  liveCalc();
}

function updateAccessoryField(idx, field, value){
  if(!FORM.accessories[idx]) return;
  FORM.accessories[idx][field] = value;
  if(field==='price') liveCalc();
}

function renderAccessoryList(){
  const el = _('acc-list');
  if(!el) return;
  const list = FORM.accessories||[];
  el.innerHTML = list.map((a,i)=>`
    <div style="margin-bottom:10px;background:#141414;border-radius:8px;padding:8px">
      <div class="row" style="gap:6px">
        <div style="flex:2"><label style="font-size:10px;color:#888">📛 نام متعلق</label><input class="inp" placeholder="مثلاً چرم، سنگ، مهره..." value="${a.name}" oninput="updateAccessoryField(${i},'name',this.value)"></div>
        <div style="flex:1"><label style="font-size:10px;color:#f0abfc">💰 قیمت (تومان)</label><input class="inp" type="text" inputmode="numeric" placeholder="مثلاً 100,000" value="${numGroup(a.price)}" oninput="updateAccessoryField(${i},'price',fmtInputLive(this))"></div>
        <button type="button" onclick="removeAccessoryRow(${i})" style="background:#2a1a1a;color:#f87171;border:none;border-radius:6px;padding:0 10px;cursor:pointer;font-family:inherit;align-self:flex-end;height:38px">✕</button>
      </div>
    </div>`).join('');
  liveCalc();
}

// ══ نوع تراکنش ══════════════════════════════════════════════════════════
function setType(t){
  FORM.type=t;
  const cols={buy:'#4ade80',sell:'#f87171',service:'#a78bfa'};
  document.querySelectorAll('.type-btn').forEach(b=>{
    const v=b.getAttribute('data-v'),c=cols[v]||'#888';
    b.style.background=v===t?c+'22':'#1a1a1a';b.style.color=v===t?c:'#555';
    b.style.border=`1px solid ${v===t?c+'55':'#2a2a2a'}`;
  });
  const isG=t==='buy'||t==='sell',isS=t==='service';
  _('row-item').style.display=isS?'none':'';_('row-svc').style.display=isS?'':'none';
  _('gf').style.display=isG?'contents':'none';
  _('sf').style.display=isS?'':'none';_('sgf').style.display=isS?'contents':'none';
  _('acc-fields').style.display = t==='sell' ? '' : 'none';
  const wpLabel = _('wp-label');
  if(wpLabel) wpLabel.textContent = t==='sell' ? 'اجرت فروش %' : 'اجرت %';
  // اجرت/سود/مالیات فقط برای فروش نمایش داده میشه — خرید فقط بر اساس ارزش طلا محاسبه میشه
  const wpvFields = _('wpv-fields');
  if(wpvFields) wpvFields.style.display = t==='sell' ? 'contents' : 'none';
  // فیلد وزن پرداخت/دریافت‌شده — فقط برای خرید و فروش (نه خرید نقدی، نه خدمات)
  const pwField = _('pw-field'), pwLabel = _('pw-label'), paidLabel = _('paid-label');
  const showPw = t==='buy'||t==='sell';
  if(pwField) pwField.style.display = showPw ? '' : 'none';
  if(pwLabel) pwLabel.textContent = t==='buy' ? 'وزن پرداخت‌شده (گرم)' : 'وزن دریافت‌شده (گرم)';
  if(paidLabel) paidLabel.textContent = t==='sell' ? 'دریافت شده (تومان)' : 'پرداخت شده (تومان)';
  const bankLabel = _('bank-acc-label');
  if(bankLabel) bankLabel.textContent = t==='sell' ? '🏦 واریز به کدام حساب' : '🏦 برداشت از کدام حساب';
  populateBankAccSelect();
  liveCalc();
}

// ══ لیست حساب‌های بانکی رو تو فرم خرید/فروش پر می‌کنه ══════════════════════
function populateBankAccSelect(){
  const sel=_('f-bank-acc'); if(!sel) return;
  const accounts=DB.bankAccounts||[];
  const cur=FORM.bankAccountId||'';
  sel.innerHTML='<option value="">— ثبت نشود —</option>'+accounts.map(a=>`<option value="${a.id}">${a.name} (${fmt(a.balance)})</option>`).join('');
  sel.value=cur;
}

// ══ انتخاب محصول ════════════════════════════════════════════════════════
function pickProd(id){
  const p=DB.products.find(x=>x.id==id);
  if(!p)return;
  FORM.item=p.name;FORM.itemCode=p.code||'';FORM.karat=p.karat||'18';
  FORM.wp=String(p.wp??10);FORM.pp=String(p.pp??7);FORM.vp=String(p.vp??10);
  FORM.weight=p.weight?String(p.weight):'';
  FORM.buyWp=(p.buyWp!=null&&p.buyWp!=='')?String(p.buyWp):'';
  _('f-item').value=p.name;_('f-karat').value=p.karat||'18';
  _('f-wp').value=p.wp??10;_('f-pp').value=p.pp??7;_('f-vp').value=p.vp??10;
  _('f-w').value=p.weight||'';
  _('quick-inp').value='';_('quick-drop').innerHTML='';
  _('sel-prod').style.display='block';
  _('sel-name').textContent=`${p.name}${p.code?' #'+p.code:''}`;
  _('sel-info').textContent=`عیار ${p.karat||18} · وزن ${p.weight||'متغیر'} گ · اجرت ${p.wp??0}٪ · سود ${p.pp??0}٪ · مالیات ${p.vp??0}٪`;
  setTimeout(()=>_('f-ppg')?.focus(),100);
  liveCalc();
}
function clearProd(){
  FORM.item='';FORM.itemCode='';FORM.weight='';FORM.buyWp='';
  _('f-item').value='';_('f-w').value='';
  _('sel-prod').style.display='none';_('quick-inp').value='';liveCalc();
}

// جستجوی سریع — فقط dropdown آپدیت میشه، بدون re-render
_('quick-inp').addEventListener('input',function(){
  const v=this.value.trim();
  if(!v){_('quick-drop').innerHTML='';return;}
  const list=DB.products.filter(p=>p.name.includes(v)||(p.code||'').toLowerCase().includes(v.toLowerCase())).slice(0,6);
  if(!list.length){_('quick-drop').innerHTML='';return;}
  _('quick-drop').innerHTML='<div class="drop">'+list.map(p=>
    `<div class="di" onmousedown="pickProd(${p.id})">
      <span style="font-weight:700">${p.name}</span>
      ${p.code?`<span style="color:#c9a84c;font-size:11px;margin-right:6px">#${p.code}</span>`:''}
      <span style="color:#555;font-size:10px;margin-right:4px">عیار ${p.karat||18}${p.weight?' · '+p.weight+'گ':''} · اجرت ${p.wp??0}٪ · سود ${p.pp??0}٪ · مالیات ${p.vp??0}٪</span>
    </div>`).join('')+'</div>';
});

function showCustDrop(){
  const v=FORM.cust,el=_('cust-drop');if(!el)return;
  const list=v?DB.cust.filter(c=>c.name.includes(v)||(c.phone||'').includes(v)).slice(0,5):[];
  el.innerHTML=list.length?'<div class="drop">'+list.map(c=>
    `<div class="di" onmousedown="pickCust(${c.id})">${c.name}${c.phone?` <span style="color:#555;font-size:11px">${c.phone}</span>`:''}</div>`
  ).join('')+'</div>':'';
}
function pickCust(id){
  const c=DB.cust.find(x=>x.id==id);if(!c)return;
  FORM.cust=c.name;FORM.phone=c.phone||'';
  _('f-cust').value=c.name;_('f-phone').value=c.phone||'';
  _('cust-drop').innerHTML='';
}
function onSvcChange(v){FORM.item=v==='__o'?'':v;_('f-svc-o').style.display=v==='__o'?'':'none';}

// ══ ثبت تراکنش ══════════════════════════════════════════════════════════
function submitTx(){
  const item=_('f-item')?.value||FORM.item;
  if(!item){alert('نام کالا یا خدمت را وارد کنید');return;}
  FORM.item=item;
  const isWeightTxType = FORM.type==='buy'||FORM.type==='sell';
  if(isWeightTxType){
    if(!(+FORM.weight>0)){alert('وزن باید بزرگ‌تر از صفر باشد');return;}
    if(!(+FORM.ppg>0)){alert('قیمت هر گرم باید بزرگ‌تر از صفر باشد');return;}
  }
  if(FORM.type==='service' && !(+FORM.sfee>0)){alert('هزینه خدمت باید بزرگ‌تر از صفر باشد');return;}
  if(+FORM.paid<0){alert('مبلغ پرداختی نمی‌تواند منفی باشد');return;}
  const c=(FORM.type==='buy'||FORM.type==='sell')?calcP():null;
  const accList = FORM.type==='sell' ? (FORM.accessories||[]).filter(a=>a.name||a.price) : [];
  const accTotal = accList.reduce((s,a)=>s+(+a.price||0),0);
  const accProfit = accList.reduce((s,a)=>s+((+a.price||0)-(+a.buyPrice||0)),0);
  const total=(c?c.total:(FORM.type==='service'?+FORM.sfee||0:0)) + accTotal;
  const paid=+FORM.paid||0,bal=total-paid;
  // مانده وزن (گرم) — فقط برای خرید/فروش، وقتی وزن پرداخت/دریافت‌شده کمتر از وزن کل باشه
  const isWeightTx = FORM.type==='buy'||FORM.type==='sell';
  const paidWeight = FORM.paidWeight!==''&&FORM.paidWeight!=null ? (+FORM.paidWeight||0) : (+FORM.weight||0);
  const weightBal = isWeightTx ? (+FORM.weight||0)-paidWeight : 0;
  const tx={id:Date.now(),date:today(),type:FORM.type,item:FORM.item,itemCode:FORM.itemCode,
    w:FORM.weight,karat:FORM.karat,ppg:FORM.ppg,cust:FORM.cust,phone:FORM.phone,
    note:FORM.note,wp:FORM.wp,pp:FORM.pp,vp:FORM.vp,
    gv:c?c.gv:0,wage:c?c.w:0,profit:(c?c.p:0)+accProfit,vat:c?c.v:0,
    total,paid,balance:bal,sfee:FORM.sfee,paidGram:FORM.paidGram,
    paidWeight:isWeightTx?paidWeight:'',weightBal,
    accessories: accList, accTotal, accProfit,
    buyWp: (FORM.type==='sell'&&FORM.buyWp!=='' &&FORM.buyWp!=null) ? (+FORM.buyWp) : null,
    bankAccountId: (isWeightTx&&FORM.bankAccountId)?(+FORM.bankAccountId):null};
  // اگه حساب بانکی انتخاب شده بود، موجودی همون حساب هم آپدیت میشه (فروش=واریز، خرید=برداشت)
  if(tx.bankAccountId && paid>0){
    const baIdx=(DB.bankAccounts||[]).findIndex(a=>a.id===tx.bankAccountId);
    if(baIdx>=0){
      const signed = FORM.type==='sell' ? paid : -paid;
      DB.bankAccounts[baIdx].balance = (+DB.bankAccounts[baIdx].balance||0) + signed;
    }
  }
  // مشتری
  if(FORM.cust){
    // خرید: مبلغِ پرداخت‌نشده یعنی فروشگاه به مشتری بدهکاره (باید از مانده کم بشه، نه اضافه)
    // فروش/خدمات: مبلغِ پرداخت‌نشده یعنی مشتری به فروشگاه بدهکاره (باید اضافه بشه)
    const custRialDelta = FORM.type==='buy' ? -bal : bal;
    const idx=DB.cust.findIndex(x=>x.name===FORM.cust);
    if(idx>=0){
      DB.cust[idx].phone=FORM.phone||DB.cust[idx].phone;
      DB.cust[idx].txCount=(DB.cust[idx].txCount||0)+1;DB.cust[idx].last=today();
      DB.cust[idx].debtRial=(DB.cust[idx].debtRial||0)+custRialDelta;
      // خرید: اگه کمتر از کل وزن پرداخت شده، مابقی به‌صورت طلب طلایی (گرم) نزد فروشگاه می‌مونه
      if(FORM.type==='buy'&&weightBal) DB.cust[idx].debtGram=(DB.cust[idx].debtGram||0)+weightBal;
      // فروش: اگه کمتر از کل وزن دریافت شده، مابقی به‌صورت بدهی گرمی مشتری ثبت میشه (عدد منفی)
      if(FORM.type==='sell'&&weightBal) DB.cust[idx].debtGram=(DB.cust[idx].debtGram||0)-weightBal;
    }else{
      const debtGram=FORM.type==='buy'?weightBal:(FORM.type==='sell'?-weightBal:0);
      DB.cust.push({id:Date.now(),name:FORM.cust,phone:FORM.phone||'',txCount:1,last:today(),
        debtRial:custRialDelta,debtGram});
    }
  }
  // موجودی — تطبیق بر اساس کد محصول (منحصربفرد) اگه وجود داشت
  const invMatchIdx = FORM.itemCode
    ? DB.inv.findIndex(i=>i.itemCode===FORM.itemCode)
    : DB.inv.findIndex(i=>i.item===FORM.item&&i.karat===FORM.karat&&!i.itemCode);
  if(FORM.type==='buy'){
    if(invMatchIdx>=0){DB.inv[invMatchIdx].w=(+DB.inv[invMatchIdx].w+(+FORM.weight||0)).toFixed(3);}
    else DB.inv.push({id:Date.now(),item:FORM.item,itemCode:FORM.itemCode,karat:FORM.karat,w:(+FORM.weight||0).toFixed(3)});
  }else if(FORM.type==='sell'){
    if(invMatchIdx>=0){
      const nw=Math.max(0,+DB.inv[invMatchIdx].w-(+FORM.weight||0));
      if(nw<=0){
        DB.inv.splice(invMatchIdx,1);
        // اگه این کالا از کاتالوگ محصولات بود و کاملاً فروخته شد، از لیست محصولات هم حذفش کن
        if(FORM.itemCode){
          DB.products = DB.products.filter(p=>p.code!==FORM.itemCode);
        }
      }
      else DB.inv[invMatchIdx].w=nw.toFixed(3);
    }
  }
  DB.tx.unshift(tx);save();
  resetForm();TAB='dashboard';showTab();
}

function resetForm(){
  FORM={type:'sell',item:'',itemCode:'',weight:'',ppg:'',karat:'18',cust:'',phone:'',note:'',qty:'1',wp:'10',pp:'7',vp:'10',sfee:'',paid:'',paidGram:'',paidWeight:'',accessories:[],buyWp:'',bankAccountId:''};
  ['f-item','f-cust','f-phone','f-w','f-ppg','f-paid','f-paid-weight','f-sfee','f-note','f-dep','f-pgram','f-depg','f-dpg','tr-inp','quick-inp'].forEach(id=>{const el=_(id);if(el)el.value='';});
  _('f-wp').value='10';_('f-pp').value='7';_('f-vp').value='10';_('f-karat').value='18';
  const fba=_('f-bank-acc'); if(fba) fba.value='';
  _('price-box').style.display='none';_('ai-err').style.display='none';
  _('sel-prod').style.display='none';_('cust-drop').innerHTML='';_('quick-drop').innerHTML='';
  const accList=_('acc-list'); if(accList) accList.innerHTML='';
  setType('sell');
}

// ══ AI ════════════════════════════════════════════════════════════════
async function doAI(){
  const txt=_('tr-inp').value;
  if(!txt.trim()){alert('متنی وارد نشده');return;}
  if(!apiKey){alert('API Key را در تنظیمات وارد کنید');return;}
  _('ai-btn').textContent='⏳...';_('ai-err').style.display='none';
  try{
    const prompt=`دستیار طلافروشی. فقط JSON خام برگردون، بدون توضیح و بدون بک‌تیک:
{"type":"buy"|"sell"|"service","item":"نام","weight":عدد|null,"ppg":عدد|null,"karat":عدد|null,"cust":"نام|null","phone":"شماره|null","note":"یا null","wp":عدد|null,"pp":عدد|null,"vp":عدد|null,"sfee":عدد|null,"paid":عدد|null}
متن:"${txt}"`;
    const res=await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent?key=${apiKey}`,{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({contents:[{parts:[{text:prompt}]}]})
    });
    const d=await res.json();
    if(d.error){ throw new Error(d.error.message||'خطای API'); }
    const t=((d.candidates||[])[0]?.content?.parts||[]).map(p=>p.text||'').join('');
    const r=JSON.parse(t.replace(/```json|```/g,'').trim());
    if(r.type&&r.type!=='unknown'){
      const sv=(id,v)=>{if(v!=null&&v!==''){const el=_(id);if(el)el.value=v;}};
      if(r.type)FORM.type=r.type;
      if(r.item){FORM.item=r.item;sv('f-item',r.item);}
      if(r.weight!=null){FORM.weight=String(r.weight);sv('f-w',r.weight);}
      if(r.ppg!=null){FORM.ppg=String(r.ppg);sv('f-ppg',r.ppg);}
      if(r.karat){FORM.karat=String(r.karat);sv('f-karat',r.karat);}
      if(r.cust){FORM.cust=r.cust;sv('f-cust',r.cust);}
      if(r.phone){FORM.phone=r.phone;sv('f-phone',r.phone);}
      if(r.note){FORM.note=r.note;sv('f-note',r.note);}
      if(r.wp!=null){FORM.wp=String(r.wp);sv('f-wp',r.wp);}
      if(r.pp!=null){FORM.pp=String(r.pp);sv('f-pp',r.pp);}
      if(r.vp!=null){FORM.vp=String(r.vp);sv('f-vp',r.vp);}
      if(r.sfee!=null){FORM.sfee=String(r.sfee);sv('f-sfee',r.sfee);}
      if(r.paid!=null){FORM.paid=String(r.paid);sv('f-paid',r.paid);}
      setType(FORM.type);liveCalc();
    }
  }catch(e){
    const el=_('ai-err');
    el.textContent='⚠️ '+(e.message||'خطا — دستی تکمیل کنید.')+' (ممکنه نیاز به فیلترشکن باشه)';
    el.style.display='';
  }
  _('ai-btn').textContent='🤖 تحلیل AI';
}

let recog=null;
function startVoice(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR){alert('لطفاً از Safari یا Chrome استفاده کنید');return;}
  recog=new SR();recog.lang='fa-IR';recog.continuous=false;recog.interimResults=false;
  recog.onresult=e=>{_('tr-inp').value=e.results[0][0].transcript;_('voice-btn').textContent='🎙️ ضبط صدا';};
  recog.onend=()=>_('voice-btn').textContent='🎙️ ضبط صدا';
  recog.onerror=()=>_('voice-btn').textContent='🎙️ ضبط صدا';
  recog.start();_('voice-btn').textContent='🔴 گوش میدم...';
}

// ══ تب‌ها ════════════════════════════════════════════════════════════════
function showTab(){
  _('pg-new').style.display=TAB==='new'?'':'none';
  _('pg-other').style.display=TAB!=='new'?'':'none';
  document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('on',b.getAttribute('data-t')===TAB));
  if(TAB!=='new')renderOther();
}
function setTab(t){if(t!=='customers')SQ.activeCust=null;TAB=t;showTab();}

// ══ دریافت قیمت لحظه‌ای طلا از brsapi.ir ══════════════════════════════════
const BRSAPI_KEY = 'BlQUxJdSMGky9Cn6aK3PxTRHGuKBK3mm'; // کلید رایگان برساپی (۱۵۰۰ درخواست/روز)

async function fetchLivePrice(){
  const btn = _('fetch-price-btn');
  const status = _('fetch-price-status');
  const apiKey = localStorage.getItem('gold_brsapi_key') || BRSAPI_KEY;

  btn.textContent = '⏳ در حال دریافت...';
  status.textContent = '';
  status.style.color = '#666';

  try{
    const res = await fetch(`https://Api.BrsApi.ir/Market/Gold_Currency.php?key=${apiKey}`);
    if(!res.ok) throw new Error('پاسخ سرور نامعتبر بود (کد ' + res.status + ')');
    const data = await res.json();

    // ساختار واقعی brsapi: { gold: [ {symbol:"IR_GOLD_18K", name:"طلای 18 عیار", price:17799500}, ... ] }
    const list = data.gold || [];
    const goldItem = list.find(item => item.symbol === 'IR_GOLD_18K')
      || list.find(item => (item.name||'').includes('18') && (item.name||'').includes('طلا'));

    if(!goldItem || !goldItem.price){
      status.style.color = '#f87171';
      status.textContent = '⚠️ آیتم طلای ۱۸ عیار در پاسخ API پیدا نشد. لطفاً قیمت رو دستی وارد کنید.';
      console.log('BRS API raw response:', data);
      btn.textContent = '🔄 دریافت خودکار قیمت لحظه‌ای';
      return;
    }

    const price = String(goldItem.price).replace(/,/g,'');
    localStorage.setItem('gold_day_price', price);
    const successMsg = `✅ قیمت بروزرسانی شد: ${(+price).toLocaleString('fa-IR')} تومان — ${goldItem.name} (${goldItem.time||''})`;
    renderOther(); // این کل داشبورد رو با قیمت جدید از نو میسازه
    // بعد از render، پیام موفقیت رو دوباره ست کن چون DOM جدید ساخته شده
    const newStatus = _('fetch-price-status');
    if(newStatus){ newStatus.style.color = '#4ade80'; newStatus.textContent = successMsg; }
  }catch(err){
    status.style.color = '#f87171';
    status.textContent = '⚠️ خطا در دریافت قیمت: ' + err.message + ' — احتمالاً نیاز به اینترنت یا فیلترشکن دارید.';
  }
  btn.textContent = '🔄 دریافت خودکار قیمت لحظه‌ای';
}

async function fetchLivePriceIntoForm(){
  const apiKey = localStorage.getItem('gold_brsapi_key') || BRSAPI_KEY;
  const ppgInput = _('f-ppg');
  const originalPlaceholder = ppgInput.placeholder;
  ppgInput.placeholder = '⏳ در حال دریافت...';

  try{
    const res = await fetch(`https://Api.BrsApi.ir/Market/Gold_Currency.php?key=${apiKey}`);
    if(!res.ok) throw new Error('پاسخ سرور نامعتبر (کد ' + res.status + ')');
    const data = await res.json();
    const list = data.gold || [];
    const goldItem = list.find(item => item.symbol === 'IR_GOLD_18K')
      || list.find(item => (item.name||'').includes('18') && (item.name||'').includes('طلا'));

    if(!goldItem || !goldItem.price){
      alert('قیمت طلای ۱۸ عیار در پاسخ سرویس پیدا نشد. لطفاً دستی وارد کنید.');
      ppgInput.placeholder = originalPlaceholder;
      return;
    }

    const price = String(goldItem.price).replace(/,/g,'');
    ppgInput.value = price;
    FORM.ppg = price;
    localStorage.setItem('gold_day_price', price);
    liveCalc();
  }catch(err){
    alert('خطا در دریافت قیمت لحظه‌ای: ' + err.message + '\nلطفاً قیمت رو دستی وارد کنید.');
  }
  ppgInput.placeholder = originalPlaceholder;
}

function saveDayPrice(){
  const v=document.getElementById('day-price-inp')?.value?.replace(/[^\d]/g,'');
  if(v){
    localStorage.setItem('gold_day_price',v);
    // آرشیو قیمت روزانه
    let hist=[];
    try{hist=JSON.parse(localStorage.getItem('gold_price_hist')||'[]');}catch{}
    const td=today();
    const idx=hist.findIndex(h=>h.date===td);
    if(idx>=0)hist[idx].price=v;
    else hist.unshift({date:td,price:v});
    if(hist.length>90)hist=hist.slice(0,90);
    localStorage.setItem('gold_price_hist',JSON.stringify(hist));
  }
  renderOther();
}

function renderOther(){
  const el=_('pg-other');
  if(TAB==='dashboard')el.innerHTML=dashH();
  else if(TAB==='transactions')el.innerHTML=txH();
  else if(TAB==='customers')el.innerHTML=custH();
  else if(TAB==='products')el.innerHTML=prodsH();
  else if(TAB==='coin'){el.innerHTML=coinH();setTimeout(()=>setCoinType('buy'),10);}
  else if(TAB==='swap'){el.innerHTML=swapH();setTimeout(()=>setSwapMode('coin'),10);}
  else if(TAB==='bank'){el.innerHTML=bankH();setTimeout(()=>{setBankMode('transfer');setBankDirection('in');},10);}
  // بعد از render، focus رو به input جستجو برگردون
  const active=el.querySelector('input[data-focus]');
  if(active)active.focus();
}

// ══ سکه ═══════════════════════════════════════════════════════════════════
const COIN_TYPES = {
  bahar: 'سکه بهار آزادی',
  emami: 'سکه امامی',
  half: 'نیم سکه',
  quarter: 'ربع سکه',
  gram1: 'سکه یک گرمی'
};

function coinH(){
  const inv = DB.coinInv || [];
  const totalCoins = inv.reduce((a,c)=>a+(+c.qty||0),0);

  const invRows = Object.keys(COIN_TYPES).map(key=>{
    const item = inv.find(c=>c.type===key);
    const qty = item ? item.qty : 0;
    return `<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #1a1a1a">
      <span style="font-weight:700;font-size:13px">${COIN_TYPES[key]}</span>
      <div style="display:flex;gap:8px;align-items:center">
        <span style="color:${qty>0?'#4ade80':'#555'};font-weight:800;font-size:14px">${qty} عدد</span>
        <button onclick="openCoinInvEdit('${key}')" style="background:#1a2a3a;color:#60a5fa;border:none;border-radius:6px;padding:3px 8px;font-size:11px;cursor:pointer;font-family:inherit">✏️</button>
      </div>
    </div>`;
  }).join('');

  const coinTx = DB.tx.filter(t=>t.type==='coinbuy'||t.type==='coinsell').slice(0,20);
  const txRows = coinTx.length===0 ? '<div class="empty">هنوز معامله سکه ثبت نشده</div>' : coinTx.map(t=>`
    <div class="card" style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div style="display:flex;gap:8px;align-items:center">
          <span class="badge" style="background:${t.type==='coinbuy'?'#1a3a2a':'#3a1a1a'};color:${t.type==='coinbuy'?'#4ade80':'#f87171'}">${t.type==='coinbuy'?'خرید سکه':'فروش سکه'}</span>
          <span style="font-weight:700;font-size:13px">${COIN_TYPES[t.coinType]||t.item}</span>
        </div>
        <span style="color:${t.type==='coinbuy'?'#4ade80':'#f87171'};font-weight:800;font-size:13px">${fmt(t.total)}</span>
      </div>
      <div class="tags">
        <span class="tag">📅 ${t.date}</span>
        <span class="tag">🔢 ${t.qty} عدد</span>
        ${t.cust?`<span class="tag">👤 ${t.cust}</span>`:''}
        ${t.note?`<span class="tag">📝 ${t.note}</span>`:''}
      </div>
    </div>`).join('');

  return `
  <div class="card" style="background:#1a1a2a;border-color:#c9a84c33">
    <div style="color:#c9a84c;font-size:12px">🪙 خرید و فروش سکه — جدا از حساب طلا. فقط قیمت کل سکه رو وارد کن.</div>
  </div>

  <div class="card">
    <div class="stitle">📦 موجودی سکه — جمع: ${totalCoins} عدد</div>
    ${invRows}
  </div>

  <div class="card">
    <div class="row" style="margin-bottom:14px">
      <button class="btn coin-type-btn" data-v="buy" onclick="setCoinType('buy')" style="flex:1">خرید سکه</button>
      <button class="btn coin-type-btn" data-v="sell" onclick="setCoinType('sell')" style="flex:1">فروش سکه</button>
    </div>
    <div class="g2">
      <div class="s2">
        <label>نوع سکه</label>
        <select id="coin-type" class="inp" onchange="COIN_FORM.coinType=this.value">
          ${Object.entries(COIN_TYPES).map(([k,v])=>`<option value="${k}">${v}</option>`).join('')}
        </select>
      </div>
      <div><label>تعداد</label><input id="coin-qty" class="inp" type="number" inputmode="numeric" value="1" oninput="COIN_FORM.qty=this.value;coinLiveCalc()"></div>
      <div><label>قیمت هر عدد (تومان)</label><input id="coin-price" class="inp" type="text" inputmode="numeric" placeholder="مثلاً 54,000,000" oninput="COIN_FORM.price=fmtInputLive(this);coinLiveCalc()"></div>
      <div class="s2"><label>نام مشتری</label><input id="coin-cust" class="inp" placeholder="اختیاری" oninput="COIN_FORM.cust=this.value"></div>
      <div class="s2"><label>شماره تماس</label><input id="coin-phone" class="inp" placeholder="اختیاری" oninput="COIN_FORM.phone=this.value"></div>
      <div class="s2"><label>پرداخت شده (تومان)</label><input id="coin-paid" class="inp" type="text" inputmode="numeric" placeholder="0 = نسیه کامل" oninput="COIN_FORM.paid=fmtInputLive(this);coinLiveCalc()"></div>
      <div class="s2"><label>یادداشت</label><input id="coin-note" class="inp" placeholder="اختیاری" oninput="COIN_FORM.note=this.value"></div>
    </div>
    <div id="coin-price-box" class="pbox" style="display:none">
      <div class="pr"><span style="color:#666">جمع کل</span><span id="coin-pc-total" style="color:#c9a84c;font-weight:800;font-size:14px"></span></div>
      <div class="pr"><span style="color:#666">پرداخت شده</span><span id="coin-pc-paid" style="color:#4ade80;font-weight:600"></span></div>
      <div style="display:flex;justify-content:space-between;padding-top:8px">
        <span style="color:#f87171;font-weight:800;font-size:13px">مانده</span>
        <span id="coin-pc-bal" style="color:#f87171;font-weight:800;font-size:15px"></span>
      </div>
    </div>
    <button id="coin-sub-btn" class="bgold" onclick="submitCoinTx()">✓ ثبت</button>
  </div>

  <div class="card">
    <div class="stitle">📋 آخرین معاملات سکه</div>
    ${txRows}
  </div>`;
}

function setCoinType(t){
  COIN_FORM.type = t;
  const cols = {buy:'#4ade80', sell:'#f87171'};
  document.querySelectorAll('.coin-type-btn').forEach(b=>{
    const v = b.getAttribute('data-v'), c = cols[v];
    b.style.background = v===t ? c+'22' : '#1a1a1a';
    b.style.color = v===t ? c : '#555';
    b.style.border = `1px solid ${v===t ? c+'55' : '#2a2a2a'}`;
  });
}

function coinLiveCalc(){
  const qty = +COIN_FORM.qty || 0;
  const price = +COIN_FORM.price || 0;
  const box = _('coin-price-box');
  if(!box) return;
  if(!qty || !price){ box.style.display='none'; return; }
  box.style.display = '';
  const total = qty * price;
  const paid = +COIN_FORM.paid || 0;
  _('coin-pc-total').textContent = fmt(total);
  _('coin-pc-paid').textContent = fmt(paid);
  _('coin-pc-bal').textContent = fmt(total-paid);
}

function submitCoinTx(){
  const qty = +COIN_FORM.qty || 0;
  const price = +COIN_FORM.price || 0;
  if(!(qty>0) || !(price>0)){ alert('تعداد و قیمت باید بزرگ‌تر از صفر باشند'); return; }
  const paid = +COIN_FORM.paid || 0;
  if(paid<0){ alert('مبلغ پرداختی نمی‌تواند منفی باشد'); return; }
  const total = qty * price;
  const balance = total - paid;
  const isBuy = COIN_FORM.type === 'buy';

  const tx = {
    id: Date.now(), date: today(),
    type: isBuy ? 'coinbuy' : 'coinsell',
    item: COIN_TYPES[COIN_FORM.coinType], coinType: COIN_FORM.coinType,
    qty, ppg: price, total, paid, balance,
    cust: COIN_FORM.cust, phone: COIN_FORM.phone, note: COIN_FORM.note,
    gv:0, wage:0, profit:0, vat:0
  };

  if(!DB.coinInv) DB.coinInv = [];
  const idx = DB.coinInv.findIndex(c=>c.type===COIN_FORM.coinType);
  if(isBuy){
    if(idx>=0) DB.coinInv[idx].qty = (+DB.coinInv[idx].qty||0) + qty;
    else DB.coinInv.push({type: COIN_FORM.coinType, qty});
  } else {
    if(idx>=0){
      const nq = Math.max(0, (+DB.coinInv[idx].qty||0) - qty);
      DB.coinInv[idx].qty = nq;
    }
  }

  if(COIN_FORM.cust){
    // مثل خرید طلا: اگه سکه از مشتری خریداری شده (coinbuy)، مانده‌ی پرداخت‌نشده یعنی فروشگاه بدهکاره، نه مشتری
    const custRialDelta = isBuy ? -balance : balance;
    const cidx = DB.cust.findIndex(c=>c.name===COIN_FORM.cust);
    if(cidx>=0){
      DB.cust[cidx].phone = COIN_FORM.phone || DB.cust[cidx].phone;
      DB.cust[cidx].txCount = (DB.cust[cidx].txCount||0)+1;
      DB.cust[cidx].last = today();
      DB.cust[cidx].debtRial = (DB.cust[cidx].debtRial||0) + custRialDelta;
    } else {
      DB.cust.push({id:Date.now(), name:COIN_FORM.cust, phone:COIN_FORM.phone||'', txCount:1, last:today(), debtRial:custRialDelta, debtGram:0});
    }
  }

  DB.tx.unshift(tx);
  save();

  COIN_FORM = {type:'buy', coinType:'emami', qty:'1', price:'', cust:'', phone:'', paid:'', note:''};
  renderOther();
}

// ══ معاوضه ═══════════════════════════════════════════════════════════════
function setSwapMode(mode){
  SWAP_FORM.mode = mode;
  const cols = {coin:'#60a5fa', gold:'#c9a84c'};
  document.querySelectorAll('.swap-mode-btn').forEach(b=>{
    const v = b.getAttribute('data-v'), c = cols[v];
    b.style.background = v===mode ? c+'22' : '#1a1a1a';
    b.style.color = v===mode ? c : '#555';
    b.style.border = `1px solid ${v===mode ? c+'55' : '#2a2a2a'}`;
  });
  const isCoinMode = mode==='coin';
  const cf = _('swap-coin-fields'), gf = _('swap-gold-fields');
  if(cf) cf.style.display = isCoinMode ? 'contents' : 'none';
  if(gf) gf.style.display = isCoinMode ? 'none' : 'contents';
  swapLiveCalc();
}

function swapLiveCalc(){
  const box = _('swap-price-box');
  if(!box) return;
  let giveVal=0, getVal=0, giveLabel='', getLabel='';

  if(SWAP_FORM.mode==='coin'){
    const gq=+SWAP_FORM.giveCoinQty||0, gp=+SWAP_FORM.giveCoinPrice||0;
    const rq=+SWAP_FORM.getCoinQty||0, rp=+SWAP_FORM.getCoinPrice||0;
    giveVal = gq*gp; getVal = rq*rp;
    giveLabel = `${COIN_TYPES[SWAP_FORM.giveCoinType]||''} (${gq} عدد)`;
    getLabel = `${COIN_TYPES[SWAP_FORM.getCoinType]||''} (${rq} عدد)`;
  } else {
    const gw=+SWAP_FORM.giveGoldWeight||0, gpg=+SWAP_FORM.giveGoldPpg||0;
    const rw=+SWAP_FORM.getGoldWeight||0, rpg=+SWAP_FORM.getGoldPpg||0;
    giveVal = gw*gpg; getVal = rw*rpg;
    giveLabel = `طلای مستعمل (${gw} گرم)`;
    getLabel = `طلای نو (${rw} گرم)`;
  }

  if(!giveVal && !getVal){ box.style.display='none'; return; }
  box.style.display = '';
  const diff = getVal - giveVal; // مثبت = ما بستانکاریم (مشتری باید بده)، منفی = ما بدهکاریم

  _('swap-give-label').textContent = giveLabel;
  _('swap-give-val').textContent = fmt(giveVal);
  _('swap-get-label').textContent = getLabel;
  _('swap-get-val').textContent = fmt(getVal);

  const diffEl = _('swap-diff-val');
  diffEl.textContent = fmt(Math.abs(diff));
  diffEl.style.color = diff>=0 ? '#f87171' : '#4ade80';
  _('swap-diff-label').textContent = diff>=0 ? 'مشتری باید به ما بپردازد' : 'ما باید به مشتری بپردازیم';
}

function submitSwap(){
  const isCoinMode = SWAP_FORM.mode==='coin';
  let giveVal=0, getVal=0, giveGram=0, getGram=0;

  if(isCoinMode){
    const gq=+SWAP_FORM.giveCoinQty||0, gp=+SWAP_FORM.giveCoinPrice||0;
    const rq=+SWAP_FORM.getCoinQty||0, rp=+SWAP_FORM.getCoinPrice||0;
    if(!(gq>0) || !(rq>0)){ alert('تعداد سکه‌های هر دو طرف باید بزرگ‌تر از صفر باشند'); return; }
    if(!(gp>0) || !(rp>0)){ alert('قیمت سکه‌های هر دو طرف باید بزرگ‌تر از صفر باشند'); return; }
    giveVal = gq*gp; getVal = rq*rp;
  } else {
    const gw=+SWAP_FORM.giveGoldWeight||0, gpg=+SWAP_FORM.giveGoldPpg||0;
    const rw=+SWAP_FORM.getGoldWeight||0, rpg=+SWAP_FORM.getGoldPpg||0;
    if(!(gw>0) || !(rw>0)){ alert('وزن طلای هر دو طرف باید بزرگ‌تر از صفر باشند'); return; }
    if(!(gpg>0) || !(rpg>0)){ alert('قیمت هر گرم هر دو طرف باید بزرگ‌تر از صفر باشند'); return; }
    giveVal = gw*gpg; getVal = rw*rpg;
    giveGram = gw; getGram = rw;
  }

  const diff = getVal - giveVal;
  const cashSettled = +SWAP_FORM.settleCash || 0;
  if(cashSettled<0){ alert('مبلغ تسویه‌شده نمی‌تواند منفی باشد'); return; }
  const remainingBalance = diff - cashSettled;

  const tx = {
    id: Date.now(), date: today(), type: 'swap',
    swapMode: SWAP_FORM.mode,
    item: isCoinMode
      ? `معاوضه سکه: ${COIN_TYPES[SWAP_FORM.giveCoinType]} ↔ ${COIN_TYPES[SWAP_FORM.getCoinType]}`
      : `معاوضه طلا: مستعمل ${SWAP_FORM.giveGoldWeight}گ ↔ نو ${SWAP_FORM.getGoldWeight}گ`,
    giveVal, getVal, diff, cashSettled, balance: remainingBalance,
    total: getVal, paid: cashSettled,
    cust: SWAP_FORM.cust, phone: SWAP_FORM.phone, note: SWAP_FORM.note,
    gv:0, wage:0, profit:0, vat:0,
    // جزئیات برای گزارش دقیق‌تر
    giveDetail: isCoinMode ? {coinType:SWAP_FORM.giveCoinType, qty:+SWAP_FORM.giveCoinQty} : {weight:giveGram},
    getDetail: isCoinMode ? {coinType:SWAP_FORM.getCoinType, qty:+SWAP_FORM.getCoinQty} : {weight:getGram}
  };

  // آپدیت موجودی
  if(isCoinMode){
    if(!DB.coinInv) DB.coinInv = [];
    // موجودی سکه‌ای که گرفتیم از مشتری زیاد میشه (نزد ما میمونه یا میفروشیم بعدا)
    const giveIdx = DB.coinInv.findIndex(c=>c.type===SWAP_FORM.giveCoinType);
    if(giveIdx>=0) DB.coinInv[giveIdx].qty = (+DB.coinInv[giveIdx].qty||0) + (+SWAP_FORM.giveCoinQty||0);
    else DB.coinInv.push({type: SWAP_FORM.giveCoinType, qty: +SWAP_FORM.giveCoinQty||0});
    // سکه‌ای که به مشتری دادیم از موجودی کم میشه
    const getIdx = DB.coinInv.findIndex(c=>c.type===SWAP_FORM.getCoinType);
    if(getIdx>=0){
      const nq = Math.max(0, (+DB.coinInv[getIdx].qty||0) - (+SWAP_FORM.getCoinQty||0));
      DB.coinInv[getIdx].qty = nq;
    }
  } else {
    // طلای مستعمل که از مشتری گرفتیم به موجودی «آبشده» اضافه میشه
    const meltedIdx = DB.inv.findIndex(i=>i.itemCode==='__MELTED__');
    if(meltedIdx>=0) DB.inv[meltedIdx].w = (+DB.inv[meltedIdx].w + giveGram).toFixed(3);
    else DB.inv.push({id:Date.now(), item:'طلای آبشده (از معاوضه)', itemCode:'__MELTED__', karat:'18', w: giveGram.toFixed(3)});
    // طلای نویی که به مشتری دادیم — اگه محصول خاصی نبود، فقط ثبت میشه (موجودی محصول‌محور جدا مدیریت میشه)
  }

  // آپدیت مشتری
  if(SWAP_FORM.cust){
    const cidx = DB.cust.findIndex(c=>c.name===SWAP_FORM.cust);
    if(cidx>=0){
      DB.cust[cidx].phone = SWAP_FORM.phone || DB.cust[cidx].phone;
      DB.cust[cidx].txCount = (DB.cust[cidx].txCount||0)+1;
      DB.cust[cidx].last = today();
      DB.cust[cidx].debtRial = (DB.cust[cidx].debtRial||0) + remainingBalance;
    } else {
      DB.cust.push({id:Date.now(), name:SWAP_FORM.cust, phone:SWAP_FORM.phone||'', txCount:1, last:today(), debtRial:remainingBalance, debtGram:0});
    }
  }

  DB.tx.unshift(tx);
  save();

  SWAP_FORM = {
    mode:'coin', giveCoinType:'emami', giveCoinQty:'1', giveCoinPrice:'',
    getCoinType:'bahar', getCoinQty:'1', getCoinPrice:'',
    giveGoldWeight:'', giveGoldPpg:'', getGoldWeight:'', getGoldPpg:'',
    cust:'', phone:'', note:'', settleCash:''
  };
  renderOther();
}

// ══ بانک ═════════════════════════════════════════════════════════════════
let BANK_FORM = {mode:'transfer', accountId:'', direction:'in', amount:'', cust:'', note:'', thirdPartyName:''};

function bankH(){
  const accounts = DB.bankAccounts||[];
  const totalBalance = accounts.reduce((a,acc)=>a+(+acc.balance||0),0);

  const accRows = accounts.length===0 ? '<div class="empty">هنوز حسابی تعریف نشده</div>' : accounts.map(acc=>`
    <div class="card" style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div>
          <div style="font-weight:700;font-size:14px">${acc.name}</div>
          <div style="color:${(+acc.balance||0)>=0?'#4ade80':'#f87171'};font-weight:800;font-size:15px;margin-top:4px">${fmt(acc.balance)}</div>
        </div>
        <div style="display:flex;gap:6px">
          <button class="btn" onclick="openModal('editBank',${acc.id})" style="background:#1a2a1a;color:#4ade80;font-size:11px;padding:5px 10px">ویرایش</button>
          <button class="btn" onclick="delBankAccount(${acc.id})" style="background:#2a1a1a;color:#f87171;font-size:11px;padding:5px 10px">حذف</button>
        </div>
      </div>
    </div>`).join('');

  const bankTx = DB.tx.filter(t=>t.type==='bankTransfer'||t.type==='thirdPartyTransfer').slice(0,15);
  const txRows = bankTx.length===0 ? '<div class="empty">هنوز تراکنش بانکی ثبت نشده</div>' : bankTx.map(t=>{
    const acc = accounts.find(a=>a.id==t.accountId);
    return `<div class="card" style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <span class="badge" style="background:${t.type==='thirdPartyTransfer'?'#2a1a3a':(t.direction==='in'?'#1a3a2a':'#3a1a1a')};color:${t.type==='thirdPartyTransfer'?'#c084fc':(t.direction==='in'?'#4ade80':'#f87171')}">${t.type==='thirdPartyTransfer'?'حواله شخص ثالث':(t.direction==='in'?'واریز':'برداشت')}</span>
        <span style="font-weight:800;font-size:13px">${fmt(t.amount)}</span>
      </div>
      <div class="tags">
        <span class="tag">📅 ${t.date}</span>
        ${acc?`<span class="tag">🏦 ${acc.name}</span>`:''}
        ${t.thirdPartyName?`<span class="tag">👤 به: ${t.thirdPartyName}</span>`:''}
        ${t.cust?`<span class="tag">👤 مشتری: ${t.cust}</span>`:''}
        ${t.note?`<span class="tag">📝 ${t.note}</span>`:''}
      </div>
    </div>`;
  }).join('');

  return `
  <div class="card" style="background:#1a1a2a;border-color:#c9a84c33">
    <div style="color:#c9a84c;font-size:12px">🏦 مدیریت حساب‌های بانکی و صندوق — موجودی هر حساب دقیق نگه داشته میشه</div>
  </div>

  <div class="row" style="margin-bottom:12px">
    <div class="stat" style="border:1px solid #c9a84c33">
      <div style="color:#666;font-size:11px;margin-bottom:3px">مجموع موجودی همه حساب‌ها</div>
      <div style="color:#c9a84c;font-size:15px;font-weight:800">${fmt(totalBalance)}</div>
    </div>
  </div>

  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
      <div class="stitle" style="margin:0">💳 حساب‌ها</div>
      <button class="btn" onclick="openModal('addBank')" style="background:#1a2a1a;color:#4ade80;font-size:11px;padding:5px 10px">+ حساب جدید</button>
    </div>
    ${accRows}
  </div>

  <div class="card">
    <div class="row" style="margin-bottom:14px">
      <button class="btn bank-mode-btn" data-v="transfer" onclick="setBankMode('transfer')" style="flex:1">واریز/برداشت حساب خودم</button>
      <button class="btn bank-mode-btn" data-v="third" onclick="setBankMode('third')" style="flex:1">حواله به شخص ثالث</button>
    </div>

    <div id="bank-transfer-fields" style="display:contents">
      <div class="g2">
        <div class="s2"><label>انتخاب حساب</label>
          <select id="bank-acc-select" class="inp" onchange="BANK_FORM.accountId=this.value">
            <option value="">انتخاب کنید...</option>
            ${accounts.map(a=>`<option value="${a.id}">${a.name} (${fmt(a.balance)})</option>`).join('')}
          </select>
        </div>
        <div class="s2">
          <div class="row">
            <button class="btn bank-dir-btn" data-v="in" onclick="setBankDirection('in')" style="flex:1">واریز (افزایش)</button>
            <button class="btn bank-dir-btn" data-v="out" onclick="setBankDirection('out')" style="flex:1">برداشت (کاهش)</button>
          </div>
        </div>
        <div class="s2"><label>مبلغ (تومان)</label><input id="bank-amount" class="inp" type="text" inputmode="numeric" placeholder="مثلاً 50,000,000" oninput="BANK_FORM.amount=fmtInputLive(this)"></div>
        <div class="s2"><label>نام مشتری (اختیاری — اگه مربوط به تسویه مشتریه)</label><input id="bank-cust" class="inp" placeholder="اختیاری" oninput="BANK_FORM.cust=this.value"></div>
        <div class="s2"><label>یادداشت</label><input id="bank-note" class="inp" placeholder="اختیاری" oninput="BANK_FORM.note=this.value"></div>
      </div>
    </div>

    <div id="bank-third-fields" style="display:none;contents">
      <div class="g2">
        <div class="s2"><label>نام شخص ثالث (کسی که پول رو گرفته)</label><input id="bank-third-name" class="inp" placeholder="مثلاً: آقای محمدی" oninput="BANK_FORM.thirdPartyName=this.value"></div>
        <div class="s2"><label>مبلغ (تومان)</label><input id="bank-third-amount" class="inp" type="text" inputmode="numeric" placeholder="مبلغی که مشتری به شخص ثالث واریز کرده" oninput="BANK_FORM.amount=fmtInputLive(this)"></div>
        <div class="s2"><label>نام مشتری (که این مبلغ بابت بدهیشه)</label><input id="bank-third-cust" class="inp" placeholder="اسم مشتری" oninput="BANK_FORM.cust=this.value"></div>
        <div class="s2"><label>یادداشت</label><input id="bank-third-note" class="inp" placeholder="اختیاری" oninput="BANK_FORM.note=this.value"></div>
      </div>
      <div style="background:#1a1a2a;border-radius:8px;padding:10px;margin-top:8px;font-size:11px;color:#c084fc">💡 این مبلغ به حساب‌های بانکی من واریز نمیشه، فقط از بدهی مشتری کم میشه</div>
    </div>

    <button class="bgold" onclick="submitBankTx()">✓ ثبت</button>
  </div>

  <div class="card">
    <div class="stitle">📋 آخرین تراکنش‌های بانکی</div>
    ${txRows}
  </div>`;
}

function setBankMode(mode){
  BANK_FORM.mode = mode;
  const cols = {transfer:'#60a5fa', third:'#c084fc'};
  document.querySelectorAll('.bank-mode-btn').forEach(b=>{
    const v = b.getAttribute('data-v'), c = cols[v];
    b.style.background = v===mode ? c+'22' : '#1a1a1a';
    b.style.color = v===mode ? c : '#555';
    b.style.border = `1px solid ${v===mode ? c+'55' : '#2a2a2a'}`;
  });
  const tf = _('bank-transfer-fields'), thf = _('bank-third-fields');
  if(tf) tf.style.display = mode==='transfer' ? 'contents' : 'none';
  if(thf) thf.style.display = mode==='third' ? 'contents' : 'none';
}

function setBankDirection(dir){
  BANK_FORM.direction = dir;
  const cols = {in:'#4ade80', out:'#f87171'};
  document.querySelectorAll('.bank-dir-btn').forEach(b=>{
    const v = b.getAttribute('data-v'), c = cols[v];
    b.style.background = v===dir ? c+'22' : '#1a1a1a';
    b.style.color = v===dir ? c : '#555';
    b.style.border = `1px solid ${v===dir ? c+'55' : '#2a2a2a'}`;
  });
}

function submitBankTx(){
  const amount = +BANK_FORM.amount || 0;
  if(!(amount>0)){ alert('مبلغ باید بزرگ‌تر از صفر باشد'); return; }

  if(BANK_FORM.mode==='transfer'){
    if(!BANK_FORM.accountId){ alert('حساب را انتخاب کنید'); return; }
    const accIdx = DB.bankAccounts.findIndex(a=>a.id==BANK_FORM.accountId);
    if(accIdx<0){ alert('حساب یافت نشد'); return; }

    const signedAmount = BANK_FORM.direction==='in' ? amount : -amount;
    DB.bankAccounts[accIdx].balance = (+DB.bankAccounts[accIdx].balance||0) + signedAmount;

    const tx = {
      id: Date.now(), date: today(), type:'bankTransfer',
      accountId: +BANK_FORM.accountId, direction: BANK_FORM.direction,
      amount, cust: BANK_FORM.cust, note: BANK_FORM.note,
      item: `${BANK_FORM.direction==='in'?'واریز':'برداشت'} — ${DB.bankAccounts[accIdx].name}`,
      total:0, paid:0, balance:0, gv:0, wage:0, profit:0, vat:0
    };

    // اگه مربوط به مشتری بود، بدهی مشتری هم کم/زیاد بشه (واریز مشتری یعنی طلبش کم میشه)
    if(BANK_FORM.cust){
      const delta = -(BANK_FORM.direction==='in' ? amount : -amount);
      const cidx = DB.cust.findIndex(c=>c.name===BANK_FORM.cust);
      if(cidx>=0){
        DB.cust[cidx].debtRial = (DB.cust[cidx].debtRial||0) + delta;
        DB.cust[cidx].last = today();
      } else {
        DB.cust.push({id:Date.now(), name:BANK_FORM.cust, phone:'', txCount:0, last:today(), debtRial:delta, debtGram:0});
      }
    }

    DB.tx.unshift(tx);
  } else {
    // حواله به شخص ثالث — فقط بدهی مشتری کم میشه، موجودی حساب من دست نمیخوره
    if(!BANK_FORM.cust){ alert('نام مشتری را وارد کنید'); return; }
    const tx = {
      id: Date.now(), date: today(), type:'thirdPartyTransfer',
      thirdPartyName: BANK_FORM.thirdPartyName, amount, cust: BANK_FORM.cust, note: BANK_FORM.note,
      item: `حواله به ${BANK_FORM.thirdPartyName||'شخص ثالث'}`,
      total:0, paid:0, balance:0, gv:0, wage:0, profit:0, vat:0
    };
    const cidx = DB.cust.findIndex(c=>c.name===BANK_FORM.cust);
    // فروشگاه از پول/منابع خودش به شخص ثالثی به‌نیابت از مشتری پرداخت کرده — یعنی مشتری این مقدار به فروشگاه بدهکار می‌شه
    // (دقیقاً هم‌جهت با برداشت مستقیم و تحویل نقدی به مشتری — همون «out» بالا)
    if(cidx>=0){
      DB.cust[cidx].debtRial = (DB.cust[cidx].debtRial||0) + amount;
      DB.cust[cidx].last = today();
    } else {
      DB.cust.push({id:Date.now(), name:BANK_FORM.cust, phone:'', txCount:0, last:today(), debtRial:amount, debtGram:0});
    }
    DB.tx.unshift(tx);
  }

  save();
  BANK_FORM = {mode:'transfer', accountId:'', direction:'in', amount:'', cust:'', note:'', thirdPartyName:''};
  renderOther();
}

function delBankAccount(id){
  if(!confirm('حذف شود؟ (موجودی این حساب هم پاک میشه)')) return;
  DB.bankAccounts = (DB.bankAccounts||[]).filter(a=>a.id!=id);
  save(); renderOther();
}

function swapH(){
  const swapTx = DB.tx.filter(t=>t.type==='swap').slice(0,15);
  const txRows = swapTx.length===0 ? '<div class="empty">هنوز معاوضه‌ای ثبت نشده</div>' : swapTx.map(t=>`
    <div class="card" style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px">
        <span class="badge" style="background:#2a1a3a;color:#c084fc">معاوضه</span>
        <span style="color:${t.balance>=0?'#f87171':'#4ade80'};font-weight:800;font-size:13px">${fmt(Math.abs(t.balance))}</span>
      </div>
      <div style="font-size:13px;font-weight:700;margin-bottom:6px">${t.item}</div>
      <div class="tags">
        <span class="tag">📅 ${t.date}</span>
        ${t.cust?`<span class="tag">👤 ${t.cust}</span>`:''}
        <span class="tag">${t.balance>=0?'طلب از مشتری':'بدهی به مشتری'}</span>
        ${t.note?`<span class="tag">📝 ${t.note}</span>`:''}
      </div>
    </div>`).join('');

  return `
  <div class="card" style="background:#1a1a2a;border-color:#c9a84c33">
    <div style="color:#c9a84c;font-size:12px">🔄 معاوضه یعنی یک نوع میدی، نوع دیگه می‌گیری — سیستم مابه‌التفاوت رو خودکار حساب می‌کنه.</div>
  </div>

  <div class="card">
    <div class="row" style="margin-bottom:14px">
      <button class="btn swap-mode-btn" data-v="coin" onclick="setSwapMode('coin')" style="flex:1">سکه ↔ سکه</button>
      <button class="btn swap-mode-btn" data-v="gold" onclick="setSwapMode('gold')" style="flex:1">طلای مستعمل ↔ طلای نو</button>
    </div>

    <div id="swap-coin-fields" style="display:contents">
      <div class="stitle" style="grid-column:span 2;margin-top:8px">📤 آنچه از مشتری می‌گیریم (پرداختی مشتری)</div>
      <div class="g2">
        <div class="s2"><label>نوع سکه</label>
          <select id="swap-give-coin-type" class="inp" onchange="SWAP_FORM.giveCoinType=this.value">
            ${Object.entries(COIN_TYPES).map(([k,v])=>`<option value="${k}">${v}</option>`).join('')}
          </select>
        </div>
        <div><label>تعداد</label><input id="swap-give-coin-qty" class="inp" type="number" value="1" oninput="SWAP_FORM.giveCoinQty=this.value;swapLiveCalc()"></div>
        <div><label>قیمت هر عدد</label><input id="swap-give-coin-price" class="inp" type="text" inputmode="numeric" placeholder="مثلاً 54,000,000" oninput="SWAP_FORM.giveCoinPrice=fmtInputLive(this);swapLiveCalc()"></div>
      </div>
      <div class="stitle" style="grid-column:span 2;margin-top:14px">📥 آنچه به مشتری می‌دهیم (دریافتی مشتری)</div>
      <div class="g2">
        <div class="s2"><label>نوع سکه</label>
          <select id="swap-get-coin-type" class="inp" onchange="SWAP_FORM.getCoinType=this.value">
            ${Object.entries(COIN_TYPES).map(([k,v])=>`<option value="${k}">${v}</option>`).join('')}
          </select>
        </div>
        <div><label>تعداد</label><input id="swap-get-coin-qty" class="inp" type="number" value="1" oninput="SWAP_FORM.getCoinQty=this.value;swapLiveCalc()"></div>
        <div><label>قیمت هر عدد</label><input id="swap-get-coin-price" class="inp" type="text" inputmode="numeric" placeholder="مثلاً 52,000,000" oninput="SWAP_FORM.getCoinPrice=fmtInputLive(this);swapLiveCalc()"></div>
      </div>
    </div>

    <div id="swap-gold-fields" style="display:none;contents">
      <div class="stitle" style="grid-column:span 2;margin-top:8px">📤 طلای مستعمل (از مشتری می‌گیریم)</div>
      <div class="g2">
        <div><label>وزن (گرم)</label><input id="swap-give-gold-w" class="inp" type="number" inputmode="decimal" placeholder="مثلاً 5.5" oninput="SWAP_FORM.giveGoldWeight=this.value;swapLiveCalc()"></div>
        <div><label>قیمت هر گرم</label><input id="swap-give-gold-ppg" class="inp" type="text" inputmode="numeric" placeholder="قیمت آبشده" oninput="SWAP_FORM.giveGoldPpg=fmtInputLive(this);swapLiveCalc()"></div>
      </div>
      <div class="stitle" style="grid-column:span 2;margin-top:14px">📥 طلای نو (به مشتری می‌دهیم)</div>
      <div class="g2">
        <div><label>وزن (گرم)</label><input id="swap-get-gold-w" class="inp" type="number" inputmode="decimal" placeholder="مثلاً 4.2" oninput="SWAP_FORM.getGoldWeight=this.value;swapLiveCalc()"></div>
        <div><label>قیمت هر گرم (با اجرت و سود)</label><input id="swap-get-gold-ppg" class="inp" type="text" inputmode="numeric" placeholder="قیمت نهایی هر گرم" oninput="SWAP_FORM.getGoldPpg=fmtInputLive(this);swapLiveCalc()"></div>
      </div>
    </div>

    <div class="g2" style="margin-top:14px">
      <div class="s2"><label>نام مشتری</label><input id="swap-cust" class="inp" placeholder="اختیاری" oninput="SWAP_FORM.cust=this.value"></div>
      <div class="s2"><label>شماره تماس</label><input id="swap-phone" class="inp" placeholder="اختیاری" oninput="SWAP_FORM.phone=this.value"></div>
      <div class="s2"><label>مبلغ تسویه‌شده نقدی (تومان)</label><input id="swap-settle" class="inp" type="text" inputmode="numeric" placeholder="اگه بخشی از مابه‌التفاوت نقد پرداخت/دریافت شده" oninput="SWAP_FORM.settleCash=fmtInputLive(this);swapLiveCalc()"></div>
      <div class="s2"><label>یادداشت</label><input id="swap-note" class="inp" placeholder="اختیاری" oninput="SWAP_FORM.note=this.value"></div>
    </div>

    <div id="swap-price-box" class="pbox" style="display:none">
      <div class="pr"><span id="swap-give-label" style="color:#666"></span><span id="swap-give-val" style="color:#f87171;font-weight:600"></span></div>
      <div class="pr"><span id="swap-get-label" style="color:#666"></span><span id="swap-get-val" style="color:#4ade80;font-weight:600"></span></div>
      <div style="display:flex;justify-content:space-between;padding-top:8px">
        <span id="swap-diff-label" style="font-weight:800;font-size:13px"></span>
        <span id="swap-diff-val" style="font-weight:800;font-size:15px"></span>
      </div>
    </div>

    <button class="bgold" onclick="submitSwap()">✓ ثبت معاوضه</button>
  </div>

  <div class="card">
    <div class="stitle">📋 آخرین معاوضه‌ها</div>
    ${txRows}
  </div>`;
}

// ══ داشبورد ══════════════════════════════════════════════════════════════
function dashH(){
  const j=toJalali(),tm=`${j.y}/${String(j.m).padStart(2,'0')}`,td=today();
  // توجه: t.total و t.profit (و بقیه‌ی فیلدهای مالی) خودشون از قبل net-of-return هستن —
  // یعنی submitReturn() به‌محض ثبت مرجوعی، این فیلدها رو مستقیم رو خودِ تراکنش اصلی متناسب کم می‌کنه.
  // پس دیگه لازم نیست اینجا دوباره چیزی رو از تراکنش‌های return کم کنیم (وگرنه دوبار کم می‌شد).

  const s=(f,k)=>DB.tx.filter(f).reduce((a,t)=>a+(+t[k]||0),0);
  const netSell=(filterFn)=>DB.tx.filter(t=>t.type==='sell'&&filterFn(t)).reduce((a,t)=>a+(+t.total||0),0);
  const netBuy=(filterFn)=>DB.tx.filter(t=>t.type==='buy'&&filterFn(t)).reduce((a,t)=>a+(+t.total||0),0);
  const netProfit=(filterFn)=>DB.tx.filter(t=>t.type==='sell'&&filterFn(t)).reduce((a,t)=>a+(+t.profit||0),0);

  const tdS=netSell(t=>t.date===td);
  const tdB=netBuy(t=>t.date===td);
  const tdSv=s(t=>t.type==='service'&&t.date===td,'sfee');
  const mS=netSell(t=>(t.date||'').startsWith(tm));
  const mB=netBuy(t=>(t.date||'').startsWith(tm));
  const mProfit=netProfit(t=>(t.date||'').startsWith(tm));
  const mSv=s(t=>t.type==='service'&&(t.date||'').startsWith(tm),'sfee');
  const tg=DB.inv.reduce((a,i)=>a+(+i.w||0),0);
  // حساب جاری مشتری — بدهکار (مشتری به ما بدهکاره) / بستانکار (ما به مشتری بدهکاریم) / تسویه
  const debtorList = DB.cust.filter(c=>(c.debtRial||0)>0);
  const creditorList = DB.cust.filter(c=>(c.debtRial||0)<0);
  const totalReceivables = debtorList.reduce((a,c)=>a+(+c.debtRial||0),0); // جمع طلب ما از مشتریان
  const totalPayables = creditorList.reduce((a,c)=>a+Math.abs(+c.debtRial||0),0); // جمع بدهی ما به مشتریان
  const debtors = debtorList.length; // برای سازگاری با کد قبلی
  const recent=DB.tx.slice(0,6).map(t=>`
    <div class="tx-row">
      <div style="display:flex;gap:8px;align-items:center">${badgeH(t.type)}
        <div><div style="font-weight:700;font-size:12px">${t.item}</div>
        <div style="color:#444;font-size:10px">${t.date}${t.cust?' · '+t.cust:''}</div></div>
      </div>
      <div style="color:${t.type==='sell'?'#f87171':t.type==='payment'?'#facc15':t.type==='service'?'#a78bfa':'#4ade80'};font-weight:700;font-size:12px">
        ${fmt(t.type==='service'?t.sfee:t.type==='payment'?t.paid:t.total)}</div>
    </div>`).join('');
  const dayPrice=+localStorage.getItem('gold_day_price')||0;
  const invList=DB.inv.length?DB.inv.map(i=>`
    <div style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid #1a1a1a">
      <div><span style="font-weight:700;font-size:13px">${i.item}</span>${i.itemCode?` <span style="color:#c9a84c;font-size:10px">#${i.itemCode}</span>`:''}<div style="color:#555;font-size:10px">عیار ${i.karat||'—'}</div></div>
      <div style="text-align:left">
        <div style="color:#c9a84c;font-weight:700;font-size:14px">${(+i.w||0).toFixed(3)} گرم</div>
        ${dayPrice?`<div style="color:#fb923c;font-size:10px">${((+i.w||0)*dayPrice).toLocaleString('fa-IR')} ت</div>`:''}
      </div>
    </div>`).join(''):'<div class="empty" style="padding:20px">موجودی ثبت نشده</div>';
  const dp=+localStorage.getItem('gold_day_price')||0;
  const totalRialVal=DB.inv.reduce((a,i)=>a+(+i.w||0)*dp,0);
  return`
  <div style="color:#555;font-size:11px;margin-bottom:8px">📅 ${td} — ${jMonth(j.m)} ${j.y}</div>
  <div class="card" style="background:#1a1a0a;border-color:#c9a84c55;margin-bottom:12px">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <div style="color:#c9a84c;font-weight:700;font-size:13px">💰 قیمت روز طلا (هر گرم ۱۸ عیار)</div>
      ${dp?`<div style="color:#fb923c;font-size:11px">ارزش موجودی: <b>${totalRialVal.toLocaleString('fa-IR')} ت</b></div>`:''}
    </div>
    <div style="display:flex;gap:8px;margin-top:8px;align-items:center">
      <input class="inp" id="day-price-inp" type="text" inputmode="numeric" value="${numGroup(dp||'')}" placeholder="مثلاً 16,400,000" oninput="fmtInputLive(this)" style="flex:1">
      <button class="btn" onclick="saveDayPrice()" style="background:#c9a84c;color:#000;white-space:nowrap">ثبت قیمت</button>
    </div>
    <div style="margin-top:8px">
      <button id="fetch-price-btn" class="btn" onclick="fetchLivePrice()" style="width:100%;background:#1a2a3a;color:#60a5fa;border:1px solid #60a5fa44">🔄 دریافت خودکار قیمت لحظه‌ای</button>
      <div id="fetch-price-status" style="font-size:11px;margin-top:6px;color:#666"></div>
    </div>
  </div>
  <div style="color:#c9a84c;font-size:12px;font-weight:700;margin-bottom:6px">امروز</div>
  <div class="row" style="flex-wrap:wrap;margin-bottom:10px">${statH('فروش',fmt(tdS),'#f87171')}${statH('خرید',fmt(tdB),'#60a5fa')}${statH('خدمات',fmt(tdSv),'#a78bfa')}</div>
  <div style="color:#c9a84c;font-size:12px;font-weight:700;margin-bottom:6px">این ماه — ${jMonth(j.m)}</div>
  <div class="row" style="flex-wrap:wrap;margin-bottom:10px">${statH('فروش',fmt(mS),'#f87171')}${statH('خرید',fmt(mB),'#60a5fa')}${statH('سود خالص',fmt(mProfit),mProfit>=0?'#4ade80':'#f87171')}</div>
  <div style="color:#c9a84c;font-size:12px;font-weight:700;margin-bottom:6px">کل</div>
  <div class="row" style="flex-wrap:wrap;margin-bottom:10px">${statH('مانده طلا',fmtG(tg),'#c9a84c')}${statH('بدهکار',debtors+' نفر','#f87171')}</div>

  <div style="color:#c9a84c;font-size:12px;font-weight:700;margin-bottom:6px">👥 حساب جاری مشتریان</div>
  <div class="row" style="flex-wrap:wrap;margin-bottom:10px">${statH('تعداد بدهکاران',debtorList.length+' نفر','#f87171')}${statH('تعداد بستانکاران',creditorList.length+' نفر','#4ade80')}</div>
  <div class="row" style="flex-wrap:wrap;margin-bottom:12px">${statH('کل مطالبات (طلب ما)',fmt(totalReceivables),'#f87171')}${statH('کل بدهی‌ها (بدهی ما)',fmt(totalPayables),'#4ade80')}</div>
  ${(debtorList.length>0||creditorList.length>0)?`<div class="card">
    <div class="stitle">📋 مشتریان با مانده باز</div>
    ${[...debtorList,...creditorList].sort((a,b)=>Math.abs(b.debtRial||0)-Math.abs(a.debtRial||0)).slice(0,8).map(c=>`
      <div class="tx-row">
        <div><span style="font-weight:700;font-size:13px">${c.name}</span>
          <span style="color:${(c.debtRial||0)>0?'#f87171':'#4ade80'};font-size:10px;margin-right:6px">${(c.debtRial||0)>0?'بدهکار':'بستانکار'}</span>
        </div>
        <span style="color:${(c.debtRial||0)>0?'#f87171':'#4ade80'};font-weight:700;font-size:13px">${fmt(Math.abs(c.debtRial||0))}</span>
      </div>`).join('')}
  </div>`:''}
  <div class="card"><div class="stitle">📦 موجودی</div>${invList}
    ${DB.inv.length?`<div style="color:#c9a84c;font-weight:800;font-size:14px;text-align:left;padding-top:8px;border-top:1px solid #2a2a2a;margin-top:4px">جمع موجودی: ${fmtG(tg)}</div>`:''}
  </div>
  <div class="card"><div class="stitle">آخرین تراکنش‌ها</div>
    ${DB.tx.length===0?'<div class="empty">هنوز تراکنشی ثبت نشده</div>':recent}
  </div>`;
}

// ══ تراکنش‌ها ════════════════════════════════════════════════════════════
function txH(){
  const types=[['all','همه'],['sell','فروش'],['buy','خرید طلا'],['service','خدمات'],['payment','پرداخت'],['return','مرجوعی']];
  let list=DB.tx;
  if(RPT.type&&RPT.type!=='all')list=list.filter(t=>t.type===RPT.type);
  if(RPT.from)list=list.filter(t=>t.date&&jCmp(t.date,RPT.from)>=0);
  if(RPT.to)list=list.filter(t=>t.date&&jCmp(t.date,RPT.to)<=0);
  if(SQ.tx)list=list.filter(t=>(t.item||'').includes(SQ.tx)||(t.cust||'').includes(SQ.tx)||(t.itemCode||'').includes(SQ.tx));
  const filts=types.map(([v,l])=>`<button class="filt ${RPT.type===v?'on':''}" onclick="RPT.type='${v}';renderOther()">${l}</button>`).join('');
  const rows=list.slice(0,50).map(t=>`
    <div class="card" style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <div style="display:flex;gap:8px;align-items:center">${badgeH(t.type)}<span style="font-weight:700;font-size:13px">${t.item}${t.itemCode?` <span style="color:#555;font-size:10px">#${t.itemCode}</span>`:''}</span></div>
        <span style="color:${t.type==='sell'?'#f87171':t.type==='payment'?'#facc15':t.type==='service'?'#a78bfa':(t.type==='bankTransfer'?(t.direction==='in'?'#4ade80':'#f87171'):t.type==='thirdPartyTransfer'?'#f87171':'#4ade80')};font-weight:800;font-size:13px">${fmt(t.type==='service'?t.sfee:t.type==='payment'?t.paid:(t.type==='bankTransfer'||t.type==='thirdPartyTransfer')?t.amount:t.total)}</span>
      </div>
      ${t.type==='sell'||t.type==='buy'?`<div class="mini">
        <div class="mc"><div style="color:#555;font-size:9px">ارزش طلا</div><div style="color:#eee;font-size:11px">${fmt(t.gv)}</div></div>
        <div class="mc"><div style="color:#555;font-size:9px">اجرت</div><div style="color:#a78bfa;font-size:11px">${fmt(t.wage)}</div></div>
        <div class="mc"><div style="color:#555;font-size:9px">سود</div><div style="color:#60a5fa;font-size:11px">${fmt(t.profit)}</div></div>
        <div class="mc"><div style="color:#555;font-size:9px">مانده</div><div style="color:#f87171;font-size:11px">${fmt(t.balance)}</div></div>
      </div>`:''}
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:6px">
        <div class="tags">
          ${t.date?`<span class="tag">📅 ${t.date}</span>`:''}${t.cust?`<span class="tag">👤 ${t.cust}</span>`:''}
          ${t.w?`<span class="tag">⚖️ ${t.w}گ</span>`:''}
          ${t.paidGram?`<span class="tag">📤 ${t.paidGram}گ</span>`:''}${t.note?`<span class="tag">📝 ${t.note}</span>`:''}
          ${t.returned?`<span class="tag" style="color:#f87171">↩️ مرجوع شده</span>`:''}
        </div>
        <div style="display:flex;gap:4px">
          ${(t.type==='sell'||t.type==='buy')&&!t.returned?`<button onclick="openReturnModal(${t.id})" style="background:#2a1a1a;color:#f87171;border:none;border-radius:6px;padding:4px 8px;font-size:10px;cursor:pointer;font-family:inherit;white-space:nowrap">↩️ مرجوعی</button>`:''}
          <button onclick="openEditTxModal(${t.id})" style="background:#1a2a1a;color:#4ade80;border:none;border-radius:6px;padding:4px 8px;font-size:10px;cursor:pointer;font-family:inherit;white-space:nowrap">✏️ ویرایش</button>
          <button onclick="printTx(${t.id})" style="background:#1a1a2a;color:#60a5fa;border:none;border-radius:6px;padding:4px 8px;font-size:10px;cursor:pointer;font-family:inherit;white-space:nowrap">🖨️ چاپ</button>
        </div>
      </div>
    </div>`).join('');
  return`
  <div class="card">
    <div class="g2" style="margin-bottom:10px">
      <div><label>از تاریخ</label><input class="inp" value="${RPT.from}" placeholder="1405/01/01" oninput="RPT.from=this.value"></div>
      <div><label>تا تاریخ</label><input class="inp" value="${RPT.to}" placeholder="1405/12/29" oninput="RPT.to=this.value"></div>
    </div>
    <input class="inp" data-focus="1" value="${SQ.tx}" placeholder="جستجو کالا، مشتری، کد..." oninput="SQ.tx=this.value;filterTx()">
  </div>
  <div style="display:flex;gap:6px;margin-bottom:12px;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:4px">${filts}</div>
  <div id="tx-list">${list.length===0?'<div class="empty">تراکنشی یافت نشد</div>':rows}</div>`;
}

// فقط لیست رو آپدیت کن بدون re-render کل صفحه
function filterTx(){
  let list=DB.tx;
  if(RPT.type&&RPT.type!=='all')list=list.filter(t=>t.type===RPT.type);
  if(RPT.from)list=list.filter(t=>t.date&&jCmp(t.date,RPT.from)>=0);
  if(RPT.to)list=list.filter(t=>t.date&&jCmp(t.date,RPT.to)<=0);
  if(SQ.tx)list=list.filter(t=>(t.item||'').includes(SQ.tx)||(t.cust||'').includes(SQ.tx)||(t.itemCode||'').includes(SQ.tx));
  const el=_('tx-list');if(!el)return;
  el.innerHTML=list.slice(0,50).map(t=>`
    <div class="card" style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <div style="display:flex;gap:8px;align-items:center">${badgeH(t.type)}<span style="font-weight:700;font-size:13px">${t.item}</span></div>
        <span style="color:${t.type==='sell'?'#f87171':t.type==='payment'?'#facc15':t.type==='service'?'#a78bfa':(t.type==='bankTransfer'?(t.direction==='in'?'#4ade80':'#f87171'):t.type==='thirdPartyTransfer'?'#f87171':'#4ade80')};font-weight:800;font-size:13px">${fmt(t.type==='service'?t.sfee:t.type==='payment'?t.paid:(t.type==='bankTransfer'||t.type==='thirdPartyTransfer')?t.amount:t.total)}</span>
      </div>
      <div class="tags">
        ${t.date?`<span class="tag">📅 ${t.date}</span>`:''}${t.cust?`<span class="tag">👤 ${t.cust}</span>`:''}
        ${t.w?`<span class="tag">⚖️ ${t.w}گ</span>`:''}${t.bankAccountId?`<span class="tag">🏦 ${(DB.bankAccounts||[]).find(a=>a.id===t.bankAccountId)?.name||''}</span>`:''}${t.note?`<span class="tag">📝 ${t.note}</span>`:''}
      </div>
    </div>`).join('')||'<div class="empty">تراکنشی یافت نشد</div>';
}

// ══ مشتریان ══════════════════════════════════════════════════════════════
function custH(){
  if(SQ.activeCust)return custProfileH(SQ.activeCust);
  const q=SQ.cust;
  const all=q?DB.cust.filter(c=>c.name.includes(q)||(c.phone||'').includes(q)):DB.cust;
  const debtors=all.filter(c=>(c.debtRial||0)!==0||(c.debtGram||0)!==0);
  const settled=all.filter(c=>!((c.debtRial||0)!==0||(c.debtGram||0)!==0));
  function cc(c){
    const ctx=DB.tx.filter(t=>t.cust===c.name);
    const cS=ctx.filter(t=>t.type==='sell').reduce((a,t)=>a+(+t.total||0),0);
    const cSv=ctx.filter(t=>t.type==='service').reduce((a,t)=>a+(+t.sfee||0),0);
    const cB=ctx.filter(t=>t.type==='buy').reduce((a,t)=>a+(+t.total||0),0);
    return`<div class="card" style="margin-bottom:8px;cursor:pointer" onclick="openCustProfile(${c.id})">
      <div style="display:flex;justify-content:space-between;align-items:flex-start">
        <div>
          <div style="font-weight:800;font-size:14px;color:#c9a84c">${c.name}</div>
          ${c.phone?`<div style="color:#555;font-size:11px;margin-top:2px">📞 ${c.phone}</div>`:''}
          <div style="color:#444;font-size:10px;margin-top:2px">آخرین: ${c.last||'—'} · ${c.txCount||0} تراکنش</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:4px;align-items:flex-end">
          <span style="color:#555;font-size:10px">← پروفایل</span>
          <button class="btn" onclick="event.stopPropagation();openPayModal('${c.name}')" style="background:#2a2a1a;color:#facc15;font-size:11px;padding:4px 8px">تسویه</button>
        </div>
      </div>
      <div class="row" style="margin-top:8px;flex-wrap:wrap;gap:6px">
        ${cS>0?`<div style="background:#2a1a1a;border-radius:6px;padding:3px 8px;font-size:11px"><span style="color:#666">فروش: </span><span style="color:#f87171">${fmt(cS)}</span></div>`:''}
        ${cB>0?`<div style="background:#1a3a1a;border-radius:6px;padding:3px 8px;font-size:11px"><span style="color:#666">خرید: </span><span style="color:#4ade80">${fmt(cB)}</span></div>`:''}
        ${cSv>0?`<div style="background:#1a1a2a;border-radius:6px;padding:3px 8px;font-size:11px"><span style="color:#666">خدمات: </span><span style="color:#a78bfa">${fmt(cSv)}</span></div>`:''}
        ${(c.debtRial||0)>0?`<div style="background:#3a1a1a;border-radius:6px;padding:3px 8px;font-size:11px"><span style="color:#666">بدهی: </span><span style="color:#f87171;font-weight:700">${fmt(c.debtRial)}</span></div>`:''}
        ${(c.debtRial||0)<0?`<div style="background:#1a2a3a;border-radius:6px;padding:3px 8px;font-size:11px"><span style="color:#666">طلب مشتری: </span><span style="color:#60a5fa;font-weight:700">${fmt(Math.abs(c.debtRial))}</span></div>`:''}
        ${(c.debtGram||0)!==0?`<div style="background:${(c.debtGram||0)>0?'#1a2a3a':'#3a1a1a'};border-radius:6px;padding:3px 8px;font-size:11px"><span style="color:#666">${(c.debtGram||0)>0?'طلب طلا: ':'بدهی طلا: '}</span><span style="color:${(c.debtGram||0)>0?'#60a5fa':'#f87171'};font-weight:700">${fmtG(Math.abs(c.debtGram))}</span></div>`:''}
      </div>
    </div>`;}
  return`
  <input class="inp" value="${q}" placeholder="جستجو نام یا شماره..." oninput="SQ.cust=this.value;filterCust()" style="margin-bottom:12px">
  <div id="cust-list">
    ${debtors.length?`<div class="stitle" style="color:#f87171;margin-bottom:8px">🔴 بدهکاران (${debtors.length} نفر)</div>${debtors.map(cc).join('')}`:''}
    ${settled.length?`<div class="stitle" style="color:#4ade80;margin-top:${debtors.length?'14px':'0'};margin-bottom:8px">✅ تسویه‌شده (${settled.length} نفر)</div>${settled.map(cc).join('')}`:''}
    ${!DB.cust.length?'<div class="empty">هنوز مشتری ثبت نشده</div>':''}
  </div>`;
}

function filterCust(){
  const q=SQ.cust;
  const all=q?DB.cust.filter(c=>c.name.includes(q)||(c.phone||'').includes(q)):DB.cust;
  const el=_('cust-list');if(!el)return;
  if(!all.length){el.innerHTML='<div class="empty">مشتری یافت نشد</div>';return;}
  el.innerHTML=all.map(c=>`
    <div class="card" style="margin-bottom:8px;cursor:pointer" onclick="openCustProfile(${c.id})">
      <div style="font-weight:800;font-size:14px;color:#c9a84c">${c.name}</div>
      ${c.phone?`<div style="color:#555;font-size:11px;margin-top:2px">📞 ${c.phone}</div>`:''}
      <div style="color:#444;font-size:10px;margin-top:2px">${c.last||'—'} · ${c.txCount||0} تراکنش
        ${(c.debtRial||0)>0?`<span style="color:#f87171;margin-right:6px">بدهی: ${fmt(c.debtRial)}</span>`:''}
      </div>
    </div>`).join('');
}

function openCustProfile(id){SQ.activeCust=id;renderOther();}

function custProfileH(custId){
  const c=DB.cust.find(x=>x.id==custId);if(!c)return custH();
  const ctx=DB.tx.filter(t=>t.cust===c.name).sort((a,b)=>jCmp(b.date,a.date));
  const totSell=ctx.filter(t=>t.type==='sell').reduce((a,t)=>a+(+t.total||0),0);
  const totBuy=ctx.filter(t=>t.type==='buy').reduce((a,t)=>a+(+t.total||0),0);
  const totSvc=ctx.filter(t=>t.type==='service').reduce((a,t)=>a+(+t.sfee||0),0);
  
  const totRetG=ctx.reduce((a,t)=>a+(+t.paidGram||0),0);
  const txRows=ctx.length===0?'<div class="empty">هیچ تراکنشی ثبت نشده</div>':ctx.map(t=>`
    <div style="padding:10px 0;border-bottom:1px solid #1a1a1a">
      <div style="display:flex;justify-content:space-between;align-items:flex-start">
        <div style="display:flex;gap:8px;align-items:center">${badgeH(t.type)}
          <div><div style="font-weight:700;font-size:13px">${t.item}</div>
          <div style="color:#444;font-size:10px">📅 ${t.date}</div></div>
        </div>
        <div style="text-align:left">
          <div style="color:${t.type==='sell'?'#f87171':t.type==='service'?'#a78bfa':t.type==='payment'?'#facc15':(t.type==='bankTransfer'?(t.direction==='in'?'#4ade80':'#f87171'):t.type==='thirdPartyTransfer'?'#f87171':'#4ade80')};font-weight:800;font-size:13px">${fmt(t.type==='service'?t.sfee:t.type==='payment'?t.paid:(t.type==='bankTransfer'||t.type==='thirdPartyTransfer')?t.amount:t.total)}</div>
          ${(t.balance||0)>0?`<div style="color:#f87171;font-size:10px">مانده: ${fmt(t.balance)}</div>`:''}
        </div>
      </div>
      <div class="tags" style="margin-top:4px">
        ${t.w?`<span class="tag">⚖️ ${t.w}گ</span>`:''}${t.karat&&t.type!=='service'&&t.type!=='payment'?`<span class="tag">✨ ${t.karat}</span>`:''}
        ${t.paidGram?`<span class="tag">📤 ${t.paidGram}گ</span>`:''}
        ${t.weightBal?`<span class="tag" style="color:${t.type==='buy'?'#60a5fa':'#f87171'}">${t.type==='buy'?'⚖️ طلب وزن: ':'⚖️ بدهی وزن: '}${fmtG(Math.abs(t.weightBal))}</span>`:''}
        ${t.type==='bankTransfer'&&t.accountId?`<span class="tag">🏦 ${(DB.bankAccounts||[]).find(a=>a.id===t.accountId)?.name||''}</span>`:''}
        ${t.note?`<span class="tag">📝 ${t.note}</span>`:''}
      </div>
    </div>`).join('');
  return`
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
    <button class="btn" onclick="SQ.activeCust=null;renderOther()" style="background:#2a2a2a;color:#eee;padding:7px 12px">← برگشت</button>
    <div style="color:#c9a84c;font-weight:800;font-size:15px">👤 ${c.name}</div>
  </div>
  <div class="card">
    <div style="display:flex;justify-content:space-between">
      <div>${c.phone?`<div style="color:#888;font-size:13px">📞 ${c.phone}</div>`:''}
        <div style="color:#444;font-size:11px;margin-top:4px">آخرین: ${c.last||'—'} · ${c.txCount||0} تراکنش</div>
      </div>
      <button class="btn" onclick="openPayModal('${c.name}')" style="background:#2a2a1a;color:#facc15">💰 تسویه</button>
    </div>
  </div>
  <div class="row" style="flex-wrap:wrap;margin-bottom:10px">
    ${statH('فروش به',fmt(totSell),'#f87171')}${statH('خرید از',fmt(totBuy),'#4ade80')}${statH('خدمات',fmt(totSvc),'#a78bfa')}
  </div>
  <div class="card" style="background:#1a1a0a;border-color:#c9a84c44">
    <div class="stitle">🧾 صورتحساب اشخاص (تراز نهایی)</div>
    <div class="g2">
      <div style="background:${(c.debtRial||0)>0?'#3a1a1a':((c.debtRial||0)<0?'#1a2a3a':'#1a2a1a')};border-radius:8px;padding:10px;text-align:center">
        <div style="color:#888;font-size:11px;margin-bottom:4px">مانده ریالی</div>
        <div style="color:${(c.debtRial||0)>0?'#f87171':((c.debtRial||0)<0?'#60a5fa':'#4ade80')};font-weight:800;font-size:16px">${(c.debtRial||0)!==0?fmt(Math.abs(c.debtRial)):'تسویه'}</div>
        <div style="color:#555;font-size:10px;margin-top:2px">${(c.debtRial||0)>0?'بدهکار به فروشگاه':((c.debtRial||0)<0?'بستانکار از فروشگاه':'حساب تسویه است')}</div>
      </div>
      <div style="background:${(c.debtGram||0)>0?'#1a2a3a':((c.debtGram||0)<0?'#3a1a1a':'#1a2a1a')};border-radius:8px;padding:10px;text-align:center">
        <div style="color:#888;font-size:11px;margin-bottom:4px">مانده طلایی</div>
        <div style="color:${(c.debtGram||0)>0?'#60a5fa':((c.debtGram||0)<0?'#f87171':'#4ade80')};font-weight:800;font-size:16px">${(c.debtGram||0)!==0?fmtG(Math.abs(c.debtGram)):'تسویه'}</div>
        <div style="color:#555;font-size:10px;margin-top:2px">${(c.debtGram||0)>0?'طلبکار از فروشگاه (وزن)':((c.debtGram||0)<0?'بدهکار به فروشگاه (وزن)':'')}</div>
      </div>
    </div>
  </div>
  <div class="row" style="flex-wrap:wrap;margin-bottom:12px">
    
    ${totRetG>0?statH('تحویل داده',fmtG(totRetG),'#4ade80'):''}
  </div>
  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
      <div class="stitle" style="margin:0">📋 تاریخچه کامل (ریز خرید و فروش)</div>
      <button onclick="printCustStatement(${c.id})" style="background:#1a1a2a;color:#60a5fa;border:none;border-radius:6px;padding:5px 10px;font-size:11px;cursor:pointer;font-family:inherit">🖨️ صورتحساب</button>
    </div>
    ${txRows}
  </div>`;
}

// ══ محصولات ══════════════════════════════════════════════════════════════
function prodsH(){
  const q=SQ.prod;
  const list=q?DB.products.filter(p=>p.name.includes(q)||(p.code||'').toLowerCase().includes(q.toLowerCase())):DB.products;
  const accCat = DB.accessoryCatalog||[];
  const accRows = accCat.length===0 ? '<div class="empty" style="padding:20px">هنوز متعلقی تعریف نشده</div>' : accCat.map(a=>{
    const profit = (+a.sellPrice||0) - (+a.buyPrice||0);
    return `<div class="card" style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div>
          <div style="font-weight:700;font-size:13px">${a.name}</div>
          <div style="color:#555;font-size:11px;margin-top:3px">خرید: ${fmt(a.buyPrice)} · فروش: ${fmt(a.sellPrice)} · سود: <span style="color:${profit>=0?'#4ade80':'#f87171'}">${fmt(profit)}</span></div>
        </div>
        <div style="display:flex;gap:6px">
          <button class="btn" onclick="openModal('editAcc',${a.id})" style="background:#1a2a1a;color:#4ade80;font-size:11px;padding:5px 10px">ویرایش</button>
          <button class="btn" onclick="delAccessory(${a.id})" style="background:#2a1a1a;color:#f87171;font-size:11px;padding:5px 10px">حذف</button>
        </div>
      </div>
    </div>`;
  }).join('');

  return`
  <div class="card" style="background:#1a1a2a;border-color:#c9a84c33">
    <div style="color:#c9a84c;font-size:12px">💡 هر محصول رو با کد تعریف کن. موقع ثبت، کد رو جستجو کن — همه فیلدها خودکار پر میشه. فقط قیمت طلا رو وارد کن.</div>
  </div>

  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
      <div class="stitle" style="margin:0">🔗 کاتالوگ متعلقات (چرم، سنگ، مهره...)</div>
      <button class="btn" onclick="openModal('addAcc')" style="background:#1a2a1a;color:#4ade80;font-size:11px;padding:5px 10px;white-space:nowrap">+ متعلق جدید</button>
    </div>
    ${accRows}
  </div>

  <div class="row" style="margin-bottom:12px">
    <input class="inp" value="${q}" placeholder="جستجو نام یا کد..." oninput="SQ.prod=this.value;filterProds()" style="flex:1">
    <button class="btn" onclick="openModal('addProd')" style="background:#1a2a1a;color:#4ade80;white-space:nowrap">+ محصول جدید</button>
  </div>
  <div id="prod-list">
  ${!list.length?'<div class="empty">هنوز محصولی تعریف نشده</div>':list.map(p=>{
    const inv=findInv(p.name,p.karat,p.code);
    return`<div class="card" style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:flex-start">
        <div>
          <div style="display:flex;gap:6px;align-items:center">
            <span style="font-weight:800;font-size:14px">${p.name}</span>
            ${p.code?`<span style="background:#2a2a2a;color:#c9a84c;border-radius:6px;padding:1px 8px;font-size:10px">#${p.code}</span>`:''}
          </div>
          <div style="color:#555;font-size:11px;margin-top:3px">عیار ${p.karat||'—'} · وزن ${p.weight?p.weight+' گ':'متغیر'} · اجرت ${p.wp??0}٪ · سود ${p.pp??0}٪ · مالیات ${p.vp??0}٪${p.buyWp!=null&&p.buyWp!==''?' · اجرت بنکدار '+p.buyWp+'٪':''}</div>
          ${inv?`<div style="margin-top:5px;display:flex;gap:6px">
            <span style="background:#1a1a1a;color:#c9a84c;border-radius:6px;padding:2px 8px;font-size:11px">${(+inv.w||0).toFixed(3)} گرم</span>
          </div>`:`<div style="color:#555;font-size:10px;margin-top:4px">موجودی: ثبت نشده</div>`}
        </div>
        <div style="display:flex;gap:6px;flex-direction:column">
          <button class="btn" onclick="quickSell(${p.id})" style="background:#3a1a1a;color:#f87171;font-size:11px;padding:5px 10px">⚡ فروش سریع</button>
          <button class="btn" onclick="openModal('editProd',${p.id})" style="background:#1a2a1a;color:#4ade80;font-size:11px;padding:5px 10px">ویرایش</button>
          <button class="btn" onclick="delProd(${p.id})" style="background:#2a1a1a;color:#f87171;font-size:11px;padding:5px 10px">حذف</button>
        </div>
      </div>
    </div>`;}).join('')}
  </div>

  <div class="card" style="margin-top:14px">
    <div class="stitle">🧾 آخرین کالاهای فروخته‌شده</div>
    ${(()=>{
      const soldList = DB.tx.filter(t=>t.type==='sell'&&t.itemCode).sort((a,b)=>jCmp(b.date,a.date)).slice(0,20);
      if(!soldList.length) return '<div class="empty" style="padding:10px 0">هنوز کالای کدداری فروخته نشده</div>';
      return soldList.map(t=>`
        <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #1a1a1a">
          <div>
            <div style="font-weight:700;font-size:13px">${t.item} <span style="background:#2a2a2a;color:#c9a84c;border-radius:6px;padding:1px 8px;font-size:10px">#${t.itemCode}</span></div>
            <div style="color:#555;font-size:11px;margin-top:2px">${t.cust?'مشتری: '+t.cust+' · ':''}${t.w?t.w+' گرم · ':''}📅 ${t.date}</div>
          </div>
          <div style="color:#f87171;font-weight:800;font-size:13px">${fmt(t.total)}</div>
        </div>`).join('');
    })()}
  </div>`;
}

function filterProds(){
  const q=SQ.prod;
  const list=q?DB.products.filter(p=>p.name.includes(q)||(p.code||'').toLowerCase().includes(q.toLowerCase())):DB.products;
  const el=_('prod-list');if(!el)return;
  el.innerHTML=list.length?list.map(p=>{
    const inv=findInv(p.name,p.karat,p.code);
    return`<div class="card" style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div>
          <span style="font-weight:800;font-size:14px">${p.name}</span>
          ${p.code?` <span style="color:#c9a84c;font-size:11px">#${p.code}</span>`:''}
          <div style="color:#555;font-size:11px;margin-top:2px">عیار ${p.karat||'—'} · اجرت ${p.wp??0}٪ · سود ${p.pp??0}٪ · مالیات ${p.vp??0}٪</div>
          ${inv?`<div style="color:#c9a84c;font-size:11px;margin-top:2px">${(+inv.w||0).toFixed(3)} گرم</div>`:''}
        </div>
        <div style="display:flex;gap:6px">
          <button class="btn" onclick="openModal('editProd',${p.id})" style="background:#1a2a1a;color:#4ade80;font-size:11px;padding:5px 10px">ویرایش</button>
          <button class="btn" onclick="delProd(${p.id})" style="background:#2a1a1a;color:#f87171;font-size:11px;padding:5px 10px">حذف</button>
        </div>
      </div>
    </div>`;}).join(''):'<div class="empty">محصولی یافت نشد</div>';
}

// ══ مودال‌ها ══════════════════════════════════════════════════════════════
function openModal(type,data){MODAL=type;MD=data||{};renderModal();}
function closeModal(){MODAL=null;MD={};_('modal-cont').innerHTML='';}
function openReturnModal(txId){
  const t=DB.tx.find(x=>x.id==txId);
  if(!t)return;
  MODAL='returnTx';MD={tx:t};renderModal();
}

function openPayModal(name){const c=DB.cust.find(x=>x.name===name);if(c){MODAL='payment';MD={cust:c};renderModal();}}

function renderModal(){
  const el=_('modal-cont');if(!MODAL){el.innerHTML='';return;}
  let html='';
  if(MODAL==='settings'){
    const brsKey = localStorage.getItem('gold_brsapi_key')||'';
    html=`<div style="color:#c9a84c;font-weight:800;font-size:16px;margin-bottom:14px">⚙️ تنظیمات</div>
    <label>API Key جمنای گوگل (برای تحلیل AI)</label>
    <input id="ak" class="inp" type="password" value="${apiKey}" placeholder="AIza..." style="margin:6px 0">
    <div style="color:#555;font-size:11px;margin-bottom:14px">رایگان از <a href="https://aistudio.google.com/apikey" target="_blank" style="color:#60a5fa">aistudio.google.com/apikey</a> (ممکنه نیاز به فیلترشکن داشته باشه)</div>
    <label>API Key قیمت طلا (brsapi.ir)</label>
    <input id="brs-ak" class="inp" type="password" value="${brsKey}" placeholder="کلید رایگان از brsapi.ir" style="margin:6px 0">
    <div style="color:#555;font-size:11px;margin-bottom:14px">برای دریافت خودکار قیمت لحظه‌ای طلا از <a href="https://brsapi.ir" target="_blank" style="color:#60a5fa">brsapi.ir</a> (۱۵۰۰ درخواست رایگان روزانه)</div>
    <div class="row"><button class="bgold" style="margin-top:0" onclick="saveKey()">ذخیره</button><button class="btn" onclick="closeModal()" style="flex:1;background:#2a2a2a;color:#eee">بستن</button></div>
    <div style="background:#2a1a1a;border:1px solid #f8717133;border-radius:10px;padding:14px;margin-top:16px">
      <div style="color:#f87171;font-weight:700;font-size:13px;margin-bottom:6px">🗑️ حذف کامل اطلاعات</div>
      <div style="color:#777;font-size:12px;margin-bottom:10px">همه‌ی تراکنش‌ها، مشتری‌ها، محصولات، حساب‌های بانکی و غیره برای همیشه پاک می‌شن. این کار قابل بازگشت نیست (مگر با فایل پشتیبان).</div>
      <button class="btn" onclick="clearAllData()" style="width:100%;background:#3a1a1a;color:#f87171;border:1px solid #f8717144;padding:12px">🗑️ حذف کامل اطلاعات و شروع مجدد</button>
    </div>`;
  }
  else if(MODAL==='backup'){
    html=`<div style="color:#2dd4bf;font-weight:800;font-size:16px;margin-bottom:14px">💾 پشتیبان‌گیری</div>

    <div style="background:#1a1a2a;border:1px solid #60a5fa33;border-radius:10px;padding:14px;margin-bottom:12px">
      <div style="color:#60a5fa;font-weight:700;font-size:13px;margin-bottom:6px">🔄 پشتیبان خودکار</div>
      <div style="color:#777;font-size:12px;margin-bottom:10px">${(()=>{
        try{
          const snap=JSON.parse(localStorage.getItem('gold_v6_autobackup'));
          return snap ? `آخرین نسخه خودکار: ${snap.jdate} (${snap.db.tx?.length||0} تراکنش) — بعد از هر ثبت خودکار آپدیت میشه، بدون نیاز به دانلود.` : 'هنوز نسخه‌ای ثبت نشده';
        }catch{return 'هنوز نسخه‌ای ثبت نشده';}
      })()}</div>
      <button class="btn" onclick="restoreFromAutoBackup()" style="width:100%;background:#1a2a3a;color:#60a5fa;border:1px solid #60a5fa44;padding:10px">↩️ بازیابی از آخرین نسخه خودکار</button>
    </div>

    <div style="background:#1a2a2a;border:1px solid #2dd4bf33;border-radius:10px;padding:14px;margin-bottom:12px">
      <div style="color:#2dd4bf;font-weight:700;font-size:13px;margin-bottom:6px">📤 دریافت فایل پشتیبان</div>
      <div style="color:#777;font-size:12px;margin-bottom:10px">همه داده‌ها در یک فایل JSON ذخیره میشه — پیشنهاد میشه هفته‌ای یکبار دانلود کنی</div>
      <button class="bgold" style="margin-top:0;background:#2dd4bf;color:#000" onclick="exportBackup()">↓ دانلود فایل پشتیبان</button>
    </div>
    <div style="background:#2a1a1a;border:1px solid #f8717133;border-radius:10px;padding:14px;margin-bottom:12px">
      <div style="color:#f87171;font-weight:700;font-size:13px;margin-bottom:6px">📥 بازیابی از فایل</div>
      <div style="color:#777;font-size:12px;margin-bottom:10px">⚠️ داده‌های فعلی جایگزین میشن</div>
      <input type="file" id="restore-file" accept=".json,application/json,text/plain,text/json,*/*" style="display:none" onchange="importBackup(this.files[0])">
      <button class="btn" onclick="_('restore-file').click()" style="width:100%;background:#3a1a1a;color:#f87171;border:1px solid #f8717144;padding:12px">📂 انتخاب فایل پشتیبان</button>
    </div>
    <button class="btn" onclick="closeModal()" style="width:100%;background:#2a2a2a;color:#eee">بستن</button>`;
  }
  else if(MODAL==='pickAcc'){
    const accCat = DB.accessoryCatalog||[];
    html=`<div style="color:#c9a84c;font-weight:800;font-size:16px;margin-bottom:14px">📋 انتخاب متعلق از کاتالوگ</div>
    ${accCat.length===0?'<div class="empty">هنوز متعلقی توی کاتالوگ نیست — اول از تب محصولات اضافه کن</div>':accCat.map(a=>`
      <div class="card" style="margin-bottom:8px;cursor:pointer" onclick="pickAccFromCatalog(${a.id})">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div>
            <div style="font-weight:700;font-size:13px">${a.name}</div>
            <div style="color:#555;font-size:11px">فروش: ${fmt(a.sellPrice)}</div>
          </div>
          <span style="color:#4ade80;font-size:12px">افزودن ←</span>
        </div>
      </div>`).join('')}
    <button class="btn" onclick="closeModal()" style="width:100%;background:#2a2a2a;color:#eee;margin-top:10px">بستن</button>`;
  }
  else if(MODAL==='addBank'||MODAL==='editBank'){
    const acc = MODAL==='editBank' ? (DB.bankAccounts||[]).find(x=>x.id==MD) : null;
    const isEdit = !!acc;
    html=`<div style="color:#c9a84c;font-weight:800;font-size:16px;margin-bottom:14px">${isEdit?'✏️ ویرایش حساب':'🏦 حساب جدید'}</div>
    <div class="g2" style="margin-bottom:14px">
      <div class="s2"><label>نام حساب *</label><input id="bank-name" class="inp" value="${acc?.name||''}" placeholder="مثلاً: بانک ملت، صندوق نقدی"></div>
      <div class="s2"><label>موجودی ${isEdit?'فعلی':'اولیه'} (تومان)</label><input id="bank-balance" class="inp" type="text" inputmode="numeric" value="${numGroup(acc?.balance||0)}" oninput="fmtInputLive(this)" placeholder="0"></div>
    </div>
    <div class="row"><button class="bgold" style="margin-top:0" onclick="saveBankAccount(${acc?.id||0})">ذخیره</button><button class="btn" onclick="closeModal()" style="flex:1;background:#2a2a2a;color:#eee">بستن</button></div>`;
  }
  else if(MODAL==='addAcc'||MODAL==='editAcc'){
    const a = MODAL==='editAcc' ? (DB.accessoryCatalog||[]).find(x=>x.id==MD) : null;
    const isEdit = !!a;
    html=`<div style="color:#c9a84c;font-weight:800;font-size:16px;margin-bottom:14px">${isEdit?'✏️ ویرایش متعلق':'🔗 متعلق جدید'}</div>
    <div class="g2" style="margin-bottom:14px">
      <div class="s2"><label>نام متعلق *</label><input id="acc-name" class="inp" value="${a?.name||''}" placeholder="مثلاً: چرم طبیعی"></div>
      <div><label>قیمت خرید (تومان)</label><input id="acc-buy" class="inp" type="text" inputmode="numeric" value="${numGroup(a?.buyPrice||'')}" oninput="fmtInputLive(this)" placeholder="مثلاً 200,000"></div>
      <div><label>قیمت فروش پیش‌فرض (تومان)</label><input id="acc-sell" class="inp" type="text" inputmode="numeric" value="${numGroup(a?.sellPrice||'')}" oninput="fmtInputLive(this)" placeholder="مثلاً 250,000"></div>
    </div>
    <div style="background:#1a2a1a;border-radius:8px;padding:10px;margin-bottom:12px;font-size:11px;color:#4ade80">💡 موقع فروش، از این کاتالوگ انتخاب کن — سود ${'(فروش−خرید)'} خودکار به سود فروشگاه اضافه میشه</div>
    <div class="row"><button class="bgold" style="margin-top:0" onclick="saveAccessory(${a?.id||0})">ذخیره</button><button class="btn" onclick="closeModal()" style="flex:1;background:#2a2a2a;color:#eee">بستن</button></div>`;
  }
  else if(MODAL==='addProd'||MODAL==='editProd'){
    const p=MODAL==='editProd'?DB.products.find(x=>x.id==MD):null;
    const isEdit=!!p;
    html=`<div style="color:#c9a84c;font-weight:800;font-size:16px;margin-bottom:14px">${isEdit?'✏️ ویرایش محصول':'🏷️ محصول جدید'}</div>
    <div class="g2" style="margin-bottom:12px">
      <div class="s2"><label>نام محصول *</label><input id="np-name" class="inp" value="${p?.name||''}" placeholder="مثلاً: گردنبند سنگین"></div>
      <div><label>کد محصول</label><input id="np-code" class="inp" value="${p?.code||''}" placeholder="G001"></div>
      <div><label>عیار</label>
        <select id="np-karat" class="inp">${['18','21','22','24'].map(k=>`<option value="${k}" ${(p?.karat||'18')===k?'selected':''}>${k}</option>`).join('')}</select>
      </div>
      <div><label>وزن ثابت (گرم)</label><input id="np-w" class="inp" type="number" inputmode="decimal" value="${p?.weight||''}" placeholder="اگه وزن ثابته وارد کن"></div>
      <div><label>اجرت %</label><input id="np-wp" class="inp" type="number" value="${p!=null?(p.wp??10):10}" placeholder="10"></div>
      <div><label>سود %</label><input id="np-pp" class="inp" type="number" value="${p!=null?(p.pp??7):7}" placeholder="7"></div>
      <div><label>مالیات %</label><input id="np-vp" class="inp" type="number" value="${p!=null?(p.vp??10):10}" placeholder="10"></div>
      <div class="s2"><label>اجرت خرید از بنکدار % (داخلی — برای محاسبه سود)</label><input id="np-buywp" class="inp" type="number" inputmode="decimal" value="${p?.buyWp??''}" placeholder="مثلاً 5 — خالی = بدون محاسبه سود مابه‌التفاوت"></div>
    </div>
    ${!isEdit?`<div style="background:#1a1a2a;border:1px solid #c9a84c33;border-radius:8px;padding:10px;margin-bottom:10px">
      <div class="stitle">📦 موجودی اولیه (اختیاری)</div>
      <div><label>وزن کل موجودی (گرم)</label><input id="np-iw" class="inp" type="number" inputmode="decimal" placeholder="خالی = از وزن ثابت بالا استفاده میشه"></div>
    </div>`:`
    <div style="background:#1a2a1a;border:1px solid #4ade8033;border-radius:8px;padding:10px;margin-bottom:10px">
      <div class="stitle" style="color:#4ade80">📦 ویرایش موجودی</div>
      <div><label>وزن موجودی (گرم)</label><input id="np-ew" class="inp" type="number" inputmode="decimal" value="${(()=>{const inv=findInv(p?.name||'',p?.karat||'18',p?.code);return inv?inv.w:(p?.weight||0);})()}"></div>
    </div>`}
    <div class="row"><button class="bgold" style="margin-top:0" onclick="saveProd(${p?.id||0})">ذخیره</button><button class="btn" onclick="closeModal()" style="flex:1;background:#2a2a2a;color:#eee">بستن</button></div>`;
  }
  else if(MODAL==='returnTx'){
    const t=MD.tx;
    const typeLabel={buy:'خرید طلا',sell:'فروش'}[t.type]||t.type;
    const isSell=t.type==='sell';
    html=`<div style="color:#f87171;font-weight:800;font-size:16px;margin-bottom:4px">↩️ ثبت مرجوعی</div>
    <div style="color:#888;font-size:13px;margin-bottom:14px">${typeLabel}: ${t.item} ${t.itemCode?'#'+t.itemCode:''}</div>
    <div style="background:#1a1a1a;border-radius:8px;padding:10px;margin-bottom:12px;font-size:12px">
      <div style="display:flex;justify-content:space-between;padding:3px 0"><span style="color:#666">وزن اصلی:</span><span>${t.w||'—'} گرم</span></div>
      <div style="display:flex;justify-content:space-between;padding:3px 0"><span style="color:#666">مبلغ اصلی:</span><span>${fmt(t.total)}</span></div>
      ${t.cust?`<div style="display:flex;justify-content:space-between;padding:3px 0"><span style="color:#666">مشتری:</span><span>${t.cust}</span></div>`:''}
    </div>
    <div class="g2" style="margin-bottom:10px">
      <div class="s2">
        <label>نوع مرجوعی</label>
        <select id="ret-type" class="inp" onchange="onRetTypeChange(this.value)">
          <option value="full">مرجوعی کامل (همه چیز برمیگرده)</option>
          <option value="partial">مرجوعی جزئی (مقدار دلخواه)</option>
        </select>
      </div>
      <div id="ret-partial-fields" style="display:none;contents">
        <div><label>وزن مرجوعی (گرم)</label><input id="ret-w" class="inp" type="number" inputmode="decimal" placeholder="مثلاً 2.5"></div>
        <div><label>مبلغ مرجوعی (تومان)</label><input id="ret-amount" class="inp" type="text" inputmode="numeric" placeholder="مبلغ بازگشتی" oninput="fmtInputLive(this)"></div>
      </div>
      <div class="s2"><label>یادداشت</label><input id="ret-note" class="inp" placeholder="دلیل مرجوعی (اختیاری)"></div>
    </div>
    <div style="background:#1a2a1a;border-radius:8px;padding:10px;margin-bottom:12px;font-size:12px;color:#4ade80">
      💡 ${isSell?'مرجوعی فروش یعنی طلا به موجودی برمیگرده و پول به مشتری برمیگردونی':'مرجوعی خرید یعنی طلا از موجودی کم میشه و پولی که دادی برمیگرده'}
    </div>
    <div class="row"><button class="bgold" style="margin-top:0;background:#f87171" onclick="submitReturn(${t.id})">ثبت مرجوعی</button><button class="btn" onclick="closeModal()" style="flex:1;background:#2a2a2a;color:#eee">بستن</button></div>`;
  }
  else if(MODAL==='editCoinInv'){
    const coinKey = MD.coinType;
    const inv = DB.coinInv || [];
    const item = inv.find(c=>c.type===coinKey);
    const currentQty = item ? item.qty : 0;
    html=`<div style="color:#c9a84c;font-weight:800;font-size:16px;margin-bottom:14px">✏️ ویرایش موجودی سکه</div>
    <div style="color:#888;font-size:13px;margin-bottom:14px">${COIN_TYPES[coinKey]}</div>
    <div style="background:#1a2a1a;border-radius:8px;padding:10px;margin-bottom:12px;font-size:12px">
      موجودی فعلی: <span style="color:#4ade80;font-weight:700">${currentQty} عدد</span>
    </div>
    <label>تعداد جدید (موجودی نهایی)</label>
    <input id="coin-inv-edit-qty" class="inp" type="number" inputmode="numeric" value="${currentQty}" style="margin:6px 0 14px">
    <div style="color:#555;font-size:11px;margin-bottom:12px">💡 این عدد جایگزین موجودی فعلی میشه — مثلاً اگه از قبل ۵ سکه داشتی، عدد ۵ رو وارد کن</div>
    <div class="row"><button class="bgold" style="margin-top:0" onclick="saveCoinInvEdit('${coinKey}')">ذخیره</button><button class="btn" onclick="closeModal()" style="flex:1;background:#2a2a2a;color:#eee">بستن</button></div>`;
  }
  else if(MODAL==='editTx'){
    const t = MD.tx;
    const typeLabel = {buy:'خرید طلا',sell:'فروش',service:'خدمات',coinbuy:'خرید سکه',coinsell:'فروش سکه',payment:'پرداخت',swap:'معاوضه',return:'مرجوعی'}[t.type]||t.type;
    const isGold = t.type==='sell'||t.type==='buy';
    const isCoin = t.type==='coinbuy'||t.type==='coinsell';
    const isService = t.type==='service';

    html = `<div style="color:#4ade80;font-weight:800;font-size:16px;margin-bottom:4px">✏️ ویرایش تراکنش</div>
    <div style="color:#888;font-size:13px;margin-bottom:14px">نوع: ${typeLabel} — تاریخ ${t.date}</div>
    <div style="background:#2a1a1a;border-radius:8px;padding:10px;margin-bottom:12px;font-size:11px;color:#f87171">⚠️ ویرایش این تراکنش، مانده‌های نقدی و گرمی رو خودکار اصلاح می‌کنه</div>
    <div class="g2">
      <div class="s2"><label>${isCoin?'نوع سکه (غیرقابل تغییر)':'نام کالا/خدمت'}</label><input id="edit-item" class="inp" value="${t.item||''}" ${isCoin?'disabled':''}></div>
      <div class="s2"><label>نام مشتری</label><input id="edit-cust" class="inp" value="${t.cust||''}"></div>
      <div class="s2"><label>شماره تماس</label><input id="edit-phone" class="inp" value="${t.phone||''}"></div>

      ${isGold?`
      <div><label>وزن (گرم)</label><input id="edit-w" class="inp" type="number" inputmode="decimal" value="${t.w||''}"></div>
      <div><label>قیمت هر گرم</label><input id="edit-ppg" class="inp" type="text" inputmode="numeric" value="${numGroup(t.ppg||'')}" oninput="fmtInputLive(this)"></div>
      <div><label>اجرت %</label><input id="edit-wp" class="inp" type="number" value="${t.wp||0}"></div>
      <div><label>سود %</label><input id="edit-pp" class="inp" type="number" value="${t.pp||0}"></div>
      <div><label>مالیات %</label><input id="edit-vp" class="inp" type="number" value="${t.vp||0}"></div>
      <div><label>پرداخت شده</label><input id="edit-paid" class="inp" type="text" inputmode="numeric" value="${numGroup(t.paid||0)}" oninput="fmtInputLive(this)"></div>
      `:''}

      ${isCoin?`
      <div><label>تعداد</label><input id="edit-qty" class="inp" type="number" value="${t.qty||1}"></div>
      <div><label>قیمت هر عدد</label><input id="edit-ppg" class="inp" type="text" inputmode="numeric" value="${numGroup(t.ppg||'')}" oninput="fmtInputLive(this)"></div>
      <div class="s2"><label>پرداخت شده</label><input id="edit-paid" class="inp" type="text" inputmode="numeric" value="${numGroup(t.paid||0)}" oninput="fmtInputLive(this)"></div>
      `:''}

      ${isService?`
      <div class="s2"><label>هزینه خدمت</label><input id="edit-sfee" class="inp" type="text" inputmode="numeric" value="${numGroup(t.sfee||0)}" oninput="fmtInputLive(this)"></div>
      <div><label>پرداخت شده</label><input id="edit-paid" class="inp" type="text" inputmode="numeric" value="${numGroup(t.paid||0)}" oninput="fmtInputLive(this)"></div>
      <div class="s2"><label>وزن تحویلی (گرم)</label><input id="edit-paidGram" class="inp" type="number" inputmode="decimal" value="${t.paidGram||''}"></div>
      `:''}

      <div class="s2"><label>یادداشت</label><input id="edit-note" class="inp" value="${t.note||''}"></div>
    </div>
    <div class="row"><button class="bgold" style="margin-top:0" onclick="saveEditedTx(${t.id})">ذخیره تغییرات</button><button class="btn" onclick="closeModal()" style="flex:1;background:#2a2a2a;color:#eee">انصراف</button></div>`;
  }
  else if(MODAL==='payment'){
    const c=MD.cust;
    html=`<div style="color:#c9a84c;font-weight:800;font-size:16px;margin-bottom:4px">💰 تسویه حساب</div>
    <div style="color:#888;font-size:13px;margin-bottom:14px">👤 ${c.name}</div>
    ${(c.debtRial||0)>0?`<div style="background:#2a1a1a;border-radius:8px;padding:10px;margin-bottom:8px;font-size:13px">بدهی ریالی: <span style="color:#f87171;font-weight:700">${fmt(c.debtRial)}</span></div>`:''}
    ${(c.debtGram||0)!==0?`<div style="background:${(c.debtGram||0)>0?'#1a2a3a':'#3a1a1a'};border-radius:8px;padding:10px;margin-bottom:8px;font-size:13px">${(c.debtGram||0)>0?'طلب طلایی مشتری':'بدهی طلایی مشتری'}: <span style="color:${(c.debtGram||0)>0?'#60a5fa':'#f87171'};font-weight:700">${fmtG(Math.abs(c.debtGram))}</span></div>`:''}
    <div class="g2" style="margin-bottom:12px">
      <div><label>پرداخت ریالی (تومان)</label><input id="pay-r" class="inp" type="text" inputmode="numeric" placeholder="0" oninput="fmtInputLive(this)"></div>
      <div><label>پرداخت طلا (گرم)</label><input id="pay-g" class="inp" type="number" inputmode="decimal" placeholder="0"></div>
      <div class="s2"><label>🏦 واریز به کدام حساب (اختیاری)</label>
        <select id="pay-bank-acc" class="inp"><option value="">— ثبت نشود —</option>${(DB.bankAccounts||[]).map(a=>`<option value="${a.id}">${a.name} (${fmt(a.balance)})</option>`).join('')}</select>
      </div>
      <div class="s2"><label>یادداشت</label><input id="pay-n" class="inp" placeholder="اختیاری"></div>
    </div>
    <div class="row"><button class="bgold" style="margin-top:0" onclick="submitPay()">ثبت پرداخت</button><button class="btn" onclick="closeModal()" style="flex:1;background:#2a2a2a;color:#eee">بستن</button></div>`;
  }
  else if(MODAL==='report'){
    let list=DB.tx;
    if(RPT.from)list=list.filter(t=>t.date&&jCmp(t.date,RPT.from)>=0);
    if(RPT.to)list=list.filter(t=>t.date&&jCmp(t.date,RPT.to)<=0);
    const tS=list.filter(t=>t.type==='sell').reduce((a,t)=>a+(+t.total||0),0);
    const tB=list.filter(t=>t.type==='buy').reduce((a,t)=>a+(+t.total||0),0);
    const tSv=list.filter(t=>t.type==='service').reduce((a,t)=>a+(+t.sfee||0),0);
    const tPaid=list.reduce((a,t)=>a+(+t.paid||0),0);
    const tBal=list.reduce((a,t)=>a+(+t.balance||0),0);
    const tGS=list.filter(t=>t.type==='sell').reduce((a,t)=>a+(+t.w||0),0);
    const tGB=list.filter(t=>t.type==='buy').reduce((a,t)=>a+(+t.w||0),0);
    const tProfit=list.filter(t=>t.type==='sell').reduce((a,t)=>a+(+t.profit||0),0);
    const tRet=list.filter(t=>t.type==='return').reduce((a,t)=>a+(+t.total||0),0);
    const dR=DB.cust.reduce((a,c)=>a+(+c.debtRial||0),0);
    const dG=DB.cust.reduce((a,c)=>a+(+c.debtGram||0),0);
    html=`<div style="color:#c9a84c;font-weight:800;font-size:16px;margin-bottom:14px">📊 گزارش</div>
    <div class="g2" style="margin-bottom:14px">
      <div><label>از تاریخ</label><input id="rpt-f" class="inp" value="${RPT.from}" placeholder="1405/01/01" oninput="RPT.from=this.value;renderModal()"></div>
      <div><label>تا تاریخ</label><input id="rpt-t" class="inp" value="${RPT.to}" placeholder="1405/12/29" oninput="RPT.to=this.value;renderModal()"></div>
    </div>
    <div class="stitle">💰 مالی</div>
    <div class="row" style="flex-wrap:wrap;margin-bottom:10px">${statH('فروش خالص',fmt(tS),'#f87171')}${statH('خرید خالص',fmt(tB),'#60a5fa')}${statH('سود خالص',fmt(tProfit),tProfit>=0?'#4ade80':'#f87171')}</div>
    <div class="row" style="flex-wrap:wrap;margin-bottom:12px">${statH('درآمد خدمات',fmt(tSv),'#a78bfa')}${statH('وصول شده',fmt(tPaid),'#4ade80')}${statH('مانده طلبکاری',fmt(tBal),'#f87171')}</div>
    <div class="row" style="flex-wrap:wrap;margin-bottom:12px">${tRet>0?statH('کل مرجوعی‌ها',fmt(tRet),'#fb7185'):''}</div>
    <div class="stitle">⚖️ گرمی</div>
    <div class="row" style="flex-wrap:wrap;margin-bottom:12px">${statH('گرم فروش',fmtG(tGS),'#f87171')}${statH('گرم خرید',fmtG(tGB),'#60a5fa')}${statH('خالص',fmtG(tGB-tGS),'#c9a84c')}</div>
    <div class="stitle">🔴 تراز کلی فروشگاه (طلب از مشتریان)</div>
    <div class="row" style="flex-wrap:wrap;margin-bottom:14px">${statH('طلب ریالی',fmt(dR),'#f87171')}${statH('طلب طلایی (امانت نزد ما)',fmtG(dG),'#60a5fa')}</div>
    <div class="stitle">👥 مشتریان</div>
    <div class="row" style="flex-wrap:wrap;margin-bottom:14px">${statH('کل مشتریان',DB.cust.length+' نفر','#c9a84c')}${statH('بدهکار',DB.cust.filter(c=>(c.debtRial||0)>0||(c.debtGram||0)>0).length+' نفر','#f87171')}</div>
    <button class="bgold" style="margin-top:0;margin-bottom:8px" onclick="exportCSV()">↓ دانلود Excel</button>
    <button class="btn" onclick="closeModal()" style="width:100%;background:#2a2a2a;color:#eee;margin-top:8px">بستن</button>
    <div style="color:#555;font-size:11px;margin-top:10px;text-align:center">💡 برای گزارش روزانه یا ماهانه، از تاریخ و تاریخ را پر کنید</div>`;
  }
  el.innerHTML=`<div class="modal-bg" onclick="if(event.target===this)closeModal()"><div class="modal">${html}</div></div>`;
}

// ══ اکشن‌ها ══════════════════════════════════════════════════════════════
function saveBankAccount(editId){
  const name = _('bank-name').value.trim();
  if(!name){ alert('نام حساب الزامی است'); return; }
  const balance = +(_('bank-balance').value||'').replace(/,/g,'') || 0;
  if(!DB.bankAccounts) DB.bankAccounts = [];
  if(editId){
    const idx = DB.bankAccounts.findIndex(a=>a.id==editId);
    if(idx>=0){ DB.bankAccounts[idx].name = name; DB.bankAccounts[idx].balance = balance; }
  } else {
    DB.bankAccounts.push({id: Date.now(), name, balance});
  }
  save(); closeModal(); renderOther();
}

function saveAccessory(editId){
  const name = _('acc-name').value.trim();
  if(!name){ alert('نام متعلق الزامی است'); return; }
  const buyPrice = +(_('acc-buy').value||'').replace(/,/g,'') || 0;
  const sellPrice = +(_('acc-sell').value||'').replace(/,/g,'') || 0;
  if(!DB.accessoryCatalog) DB.accessoryCatalog = [];
  if(editId){
    const idx = DB.accessoryCatalog.findIndex(a=>a.id==editId);
    if(idx>=0) DB.accessoryCatalog[idx] = {...DB.accessoryCatalog[idx], name, buyPrice, sellPrice};
  } else {
    DB.accessoryCatalog.push({id: Date.now(), name, buyPrice, sellPrice});
  }
  save(); closeModal(); renderOther();
}

function delAccessory(id){
  if(!confirm('حذف شود؟')) return;
  DB.accessoryCatalog = (DB.accessoryCatalog||[]).filter(a=>a.id!=id);
  save(); renderOther();
}

function saveProd(editId){
  const name=_('np-name').value.trim();if(!name){alert('نام الزامی');return;}
  const code=_('np-code').value.trim(),karat=_('np-karat').value;
  const weight=+(_('np-w')?.value||0)||null;
  const wp=+(_('np-wp')?.value??10),pp=+(_('np-pp')?.value??7),vp=+(_('np-vp')?.value??10);
  const buyWpRaw=_('np-buywp')?.value;
  const buyWp=(buyWpRaw!=null&&buyWpRaw!=='')?+buyWpRaw:null;
  if(editId){
    const idx=DB.products.findIndex(p=>p.id==editId);
    if(idx>=0){
      const old=DB.products[idx];
      DB.products[idx]={...old,name,code,karat,weight,wp,pp,vp,buyWp};
      // آپدیت موجودی — پیدا کردن بر اساس کد قدیمی (منحصربفرد) نه نام+عیار
      const invIdx = old.code
        ? DB.inv.findIndex(i=>i.itemCode===old.code)
        : DB.inv.findIndex(i=>i.item===old.name&&i.karat===old.karat&&!i.itemCode);
      const ew=_('np-ew')?.value;
      if(invIdx>=0){
        DB.inv[invIdx].item=name;DB.inv[invIdx].itemCode=code;DB.inv[invIdx].karat=karat;
        if(ew!=null&&ew!=='')DB.inv[invIdx].w=(+ew).toFixed(3);
        else if(weight)DB.inv[invIdx].w=(+weight).toFixed(3);
      }else if((ew&&+ew>0)||weight){
        DB.inv.push({id:Date.now(),item:name,itemCode:code,karat,w:ew?(+ew).toFixed(3):(+weight||0).toFixed(3)});
      }
      // آپدیت تراکنش‌ها — بر اساس کد قدیمی اگه داشت
      if(old.name!==name||old.karat!==karat||old.code!==code){
        DB.tx.forEach(t=>{
          const matches = old.code ? t.itemCode===old.code : (t.item===old.name&&t.karat===old.karat&&!t.itemCode);
          if(matches){t.item=name;t.itemCode=code;t.karat=karat;}
        });
      }
    }
  }else{
    // چک تکراری نبودن کد
    if(code && DB.products.some(p=>p.code===code)){
      alert('این کد قبلاً برای محصول دیگری استفاده شده. کد باید منحصربفرد باشد.');
      return;
    }
    DB.products.push({id:Date.now(),name,code,karat,weight,wp,pp,vp,buyWp});
    const iwVal=_('np-iw')?.value?.trim();
    const iw=iwVal?+iwVal:(weight||0);
    if(iw>0){
      // موجودی جدید همیشه یه ردیف جدید — چون کد منحصربفرده
      const idx = code ? DB.inv.findIndex(i=>i.itemCode===code) : -1;
      if(idx>=0){DB.inv[idx].w=(+DB.inv[idx].w+iw).toFixed(3);}
      else DB.inv.push({id:Date.now(),item:name,itemCode:code,karat,w:iw.toFixed(3)});
    }
  }
  save();closeModal();renderOther();
}

function quickSell(prodId){
  const p=DB.products.find(x=>x.id==prodId);
  if(!p)return;
  TAB='new';showTab();
  setTimeout(()=>{
    pickProd(prodId);
    setType('sell');
  },100);
}

function delProd(id){
  if(!confirm('حذف شود؟'))return;
  const p=DB.products.find(x=>x.id==id);
  if(p){
    // حذف موجودی مرتبط — بر اساس کد اگه داشت
    if(p.code) DB.inv=DB.inv.filter(i=>i.itemCode!==p.code);
    else DB.inv=DB.inv.filter(i=>!(i.item===p.name&&i.karat===p.karat&&!i.itemCode));
  }
  DB.products=DB.products.filter(x=>x.id!=id);
  save();renderOther();
}

// ══ ویرایش تراکنش ═══════════════════════════════════════════════════════════
// برگردوندن اثر یک تراکنش (موجودی، بدهی مشتری، موجودی سکه) — قبل از ویرایش یا حذف
function revertTxEffects(t){
  // برگردوندن موجودی طلا
  if(t.type==='buy'){
    const invIdx = t.itemCode ? DB.inv.findIndex(i=>i.itemCode===t.itemCode) : DB.inv.findIndex(i=>i.item===t.item&&i.karat===t.karat&&!i.itemCode);
    if(invIdx>=0){
      const nw = Math.max(0, +DB.inv[invIdx].w - (+t.w||0));
      if(nw<=0) DB.inv.splice(invIdx,1);
      else DB.inv[invIdx].w = nw.toFixed(3);
    }
  } else if(t.type==='sell'){
    const invIdx = t.itemCode ? DB.inv.findIndex(i=>i.itemCode===t.itemCode) : DB.inv.findIndex(i=>i.item===t.item&&i.karat===t.karat&&!i.itemCode);
    if(invIdx>=0) DB.inv[invIdx].w = (+DB.inv[invIdx].w + (+t.w||0)).toFixed(3);
    else if(t.itemCode) DB.inv.push({id:Date.now(), item:t.item, itemCode:t.itemCode, karat:t.karat, w:(+t.w||0).toFixed(3)});
  }
  // برگردوندن موجودی سکه
  else if(t.type==='coinbuy'){
    const idx = (DB.coinInv||[]).findIndex(c=>c.type===t.coinType);
    if(idx>=0) DB.coinInv[idx].qty = Math.max(0, (+DB.coinInv[idx].qty||0) - (+t.qty||0));
  } else if(t.type==='coinsell'){
    const idx = (DB.coinInv||[]).findIndex(c=>c.type===t.coinType);
    if(idx>=0) DB.coinInv[idx].qty = (+DB.coinInv[idx].qty||0) + (+t.qty||0);
    else DB.coinInv.push({type:t.coinType, qty:+t.qty||0});
  }
  // برگردوندن معاوضه
  else if(t.type==='swap'){
    if(t.swapMode==='coin'){
      const gd = t.giveDetail||{}, gtd = t.getDetail||{};
      const giveIdx = (DB.coinInv||[]).findIndex(c=>c.type===gd.coinType);
      if(giveIdx>=0) DB.coinInv[giveIdx].qty = Math.max(0,(+DB.coinInv[giveIdx].qty||0)-(+gd.qty||0));
      const getIdx = (DB.coinInv||[]).findIndex(c=>c.type===gtd.coinType);
      if(getIdx>=0) DB.coinInv[getIdx].qty = (+DB.coinInv[getIdx].qty||0)+(+gtd.qty||0);
      else DB.coinInv.push({type:gtd.coinType, qty:+gtd.qty||0});
    } else {
      const gw = (t.giveDetail||{}).weight || 0;
      const meltedIdx = DB.inv.findIndex(i=>i.itemCode==='__MELTED__');
      if(meltedIdx>=0){
        const nw = Math.max(0, +DB.inv[meltedIdx].w - gw);
        if(nw<=0) DB.inv.splice(meltedIdx,1);
        else DB.inv[meltedIdx].w = nw.toFixed(3);
      }
    }
  }
  // برگردوندن مانده مشتری (بدهی ریالی و گرمی)
  if(t.cust){
    const cidx = DB.cust.findIndex(c=>c.name===t.cust);
    if(cidx>=0){
      // باید دقیقاً معکوس همون چیزی باشه که در submitTx()/submitCoinTx() اضافه شده (برای خرید طلا و خرید سکه علامت برعکسه)
      const custRialDelta = (t.type==='buy'||t.type==='coinbuy') ? -(+t.balance||0) : (+t.balance||0);
      DB.cust[cidx].debtRial = (DB.cust[cidx].debtRial||0) - custRialDelta;
      DB.cust[cidx].txCount = Math.max(0, (DB.cust[cidx].txCount||0) - 1);
      if(t.type==='service'&&t.paidGram) DB.cust[cidx].debtGram = (DB.cust[cidx].debtGram||0) + (+t.paidGram||0);
      if(t.type==='buy'&&t.weightBal) DB.cust[cidx].debtGram = (DB.cust[cidx].debtGram||0) - (+t.weightBal||0);
      if(t.type==='sell'&&t.weightBal) DB.cust[cidx].debtGram = (DB.cust[cidx].debtGram||0) + (+t.weightBal||0);
    }
  }
  // برگردوندن موجودی حساب بانکی (اگه این تراکنش به یه حساب لینک شده بود)
  if(t.bankAccountId){
    const baIdx=(DB.bankAccounts||[]).findIndex(a=>a.id===t.bankAccountId);
    if(baIdx>=0){
      const signed = (t.type==='sell'||t.type==='payment') ? (+t.paid||0) : -(+t.paid||0);
      DB.bankAccounts[baIdx].balance = (+DB.bankAccounts[baIdx].balance||0) - signed;
    }
  }
}

function openEditTxModal(txId){
  const t = DB.tx.find(x=>x.id==txId);
  if(!t) return;
  MODAL='editTx'; MD={tx:t}; renderModal();
}

function saveEditedTx(txId){
  const idx = DB.tx.findIndex(x=>x.id==txId);
  if(idx<0) return;
  const oldTx = DB.tx[idx];

  // ۱. برگردوندن اثر تراکنش قدیمی
  revertTxEffects(oldTx);

  // ۲. خوندن مقادیر جدید از فرم ویرایش
  const g = id => _(id)?.value;
  const newItem = g('edit-item') ?? oldTx.item;
  const newCust = g('edit-cust') ?? oldTx.cust;
  const newPhone = g('edit-phone') ?? oldTx.phone;
  const newNote = g('edit-note') ?? oldTx.note;
  const newW = g('edit-w'); 
  const newPpg = g('edit-ppg')!=null?String(g('edit-ppg')).replace(/,/g,''):null;
  const newWp = g('edit-wp'), newPp = g('edit-pp'), newVp = g('edit-vp');
  const newPaid = g('edit-paid')!=null?String(g('edit-paid')).replace(/,/g,''):null;
  const newSfee = g('edit-sfee')!=null?String(g('edit-sfee')).replace(/,/g,''):null;
  const newQty = g('edit-qty');
  const newPaidGram = g('edit-paidGram');

  let updated = {...oldTx, item:newItem, cust:newCust, phone:newPhone, note:newNote};

  if(oldTx.type==='sell'||oldTx.type==='buy'){
    updated.w = newW; updated.ppg = newPpg; updated.wp = newWp; updated.pp = newPp; updated.vp = newVp;
    const gv = Math.round((+newPpg||0)*(+newW||0));
    const wage = Math.round(gv*(+newWp||0)/100);
    // مابه‌التفاوت اجرت خرید از بنکدار (اگه این تراکنش به یه محصول با buyWp وصل بود) — باید موقع ویرایش هم حفظ بشه
    const wageDiff = (oldTx.type==='sell' && oldTx.buyWp!=null) ? Math.round(gv*((+newWp||0)-(+oldTx.buyWp||0))/100) : 0;
    const profit = Math.round((gv+wage)*(+newPp||0)/100) + wageDiff;
    const vat = Math.round((wage+profit-wageDiff)*(+newVp||0)/100);
    const accTotal = (oldTx.accessories||[]).reduce((s,a)=>s+(+a.price||0),0);
    // اگه این تراکنش قبلاً (کامل یا جزئی) مرجوع شده، اون مبلغ باید از جمع کل جدید هم کم بمونه — وگرنه اثر مرجوعی با ویرایش پاک میشه
    const returnedTotal = +oldTx.returnedTotal||0;
    const total = Math.max(0, gv+wage+profit+vat+accTotal-returnedTotal);
    const paid = +newPaid||0;
    updated = {...updated, gv, wage, profit, vat, total, paid, balance: total-paid};
  } else if(oldTx.type==='service'){
    updated.sfee = newSfee;
    updated.paid = +newPaid||0;
    updated.total = +newSfee||0;
    updated.balance = (+newSfee||0) - (+newPaid||0);
    updated.paidGram = newPaidGram;
  } else if(oldTx.type==='coinbuy'||oldTx.type==='coinsell'){
    updated.qty = newQty; updated.ppg = newPpg;
    const total = (+newQty||0)*(+newPpg||0);
    updated.total = total; updated.paid = +newPaid||0; updated.balance = total - (+newPaid||0);
  } else if(oldTx.type==='payment'){
    updated.paid = +newPaid||0;
    updated.paidGram = newPaidGram;
  }

  DB.tx[idx] = updated;

  // ۳. اعمال دوباره اثر تراکنش جدید (شبیه ثبت اولیه)
  reapplyTxEffects(updated);

  save();
  closeModal();
  TAB='transactions'; showTab();
}

// اعمال اثر تراکنش (موجودی + مشتری) — استفاده مجدد بعد از ویرایش
function reapplyTxEffects(t){
  if(t.type==='buy'){
    const invIdx = t.itemCode ? DB.inv.findIndex(i=>i.itemCode===t.itemCode) : DB.inv.findIndex(i=>i.item===t.item&&i.karat===t.karat&&!i.itemCode);
    if(invIdx>=0) DB.inv[invIdx].w = (+DB.inv[invIdx].w + (+t.w||0)).toFixed(3);
    else DB.inv.push({id:Date.now(), item:t.item, itemCode:t.itemCode, karat:t.karat, w:(+t.w||0).toFixed(3)});
  } else if(t.type==='sell'){
    const invIdx = t.itemCode ? DB.inv.findIndex(i=>i.itemCode===t.itemCode) : DB.inv.findIndex(i=>i.item===t.item&&i.karat===t.karat&&!i.itemCode);
    if(invIdx>=0){
      const nw = Math.max(0, +DB.inv[invIdx].w - (+t.w||0));
      if(nw<=0) DB.inv.splice(invIdx,1);
      else DB.inv[invIdx].w = nw.toFixed(3);
    }
  } else if(t.type==='coinbuy'){
    if(!DB.coinInv) DB.coinInv=[];
    const idx = DB.coinInv.findIndex(c=>c.type===t.coinType);
    if(idx>=0) DB.coinInv[idx].qty = (+DB.coinInv[idx].qty||0) + (+t.qty||0);
    else DB.coinInv.push({type:t.coinType, qty:+t.qty||0});
  } else if(t.type==='coinsell'){
    if(!DB.coinInv) DB.coinInv=[];
    const idx = DB.coinInv.findIndex(c=>c.type===t.coinType);
    if(idx>=0) DB.coinInv[idx].qty = Math.max(0, (+DB.coinInv[idx].qty||0) - (+t.qty||0));
  }

  if(t.cust){
    const custRialDelta = (t.type==='buy'||t.type==='coinbuy') ? -(+t.balance||0) : (+t.balance||0);
    const cidx = DB.cust.findIndex(c=>c.name===t.cust);
    if(cidx>=0){
      DB.cust[cidx].phone = t.phone || DB.cust[cidx].phone;
      DB.cust[cidx].txCount = (DB.cust[cidx].txCount||0)+1;
      DB.cust[cidx].last = today();
      DB.cust[cidx].debtRial = (DB.cust[cidx].debtRial||0) + custRialDelta;
      if(t.type==='service'&&t.paidGram) DB.cust[cidx].debtGram = Math.max(0,(DB.cust[cidx].debtGram||0)-(+t.paidGram||0));
      if(t.type==='buy'&&t.weightBal) DB.cust[cidx].debtGram = (DB.cust[cidx].debtGram||0) + (+t.weightBal||0);
      if(t.type==='sell'&&t.weightBal) DB.cust[cidx].debtGram = (DB.cust[cidx].debtGram||0) - (+t.weightBal||0);
    } else {
      const debtGram = t.type==='buy'?(+t.weightBal||0):(t.type==='sell'?-(+t.weightBal||0):0);
      DB.cust.push({id:Date.now(), name:t.cust, phone:t.phone||'', txCount:1, last:today(), debtRial:custRialDelta, debtGram});
    }
  }
  // اعمال دوباره اثر روی حساب بانکی لینک‌شده
  if(t.bankAccountId){
    const baIdx=(DB.bankAccounts||[]).findIndex(a=>a.id===t.bankAccountId);
    if(baIdx>=0){
      const signed = (t.type==='sell'||t.type==='payment') ? (+t.paid||0) : -(+t.paid||0);
      DB.bankAccounts[baIdx].balance = (+DB.bankAccounts[baIdx].balance||0) + signed;
    }
  }
}

function submitPay(){
  const c=MD.cust,rial=+(_('pay-r').value||'').replace(/,/g,'')||0,gram=+_('pay-g').value||0,note=_('pay-n').value||'';
  const bankAccountId=_('pay-bank-acc')?.value?+_('pay-bank-acc').value:null;
  if(!rial&&!gram){alert('مبلغ یا گرم وارد کنید');return;}
  if(rial<0||gram<0){alert('مبلغ یا گرم نمی‌تواند منفی باشد');return;}
  const idx=DB.cust.findIndex(x=>x.name===c.name);
  if(idx>=0){
    // ریالی: مثبت = بدهکار مشتری، منفی = بستانکار مشتری (امانت نزد فروشگاه)
    // پرداخت ریالی یعنی مشتری پول به فروشگاه داده → همیشه از بدهکاری‌اش کم می‌شه (بدون توجه به علامت فعلی)
    DB.cust[idx].debtRial = (DB.cust[idx].debtRial||0) - rial;
    // گرمی: مثبت = طلبکار مشتری (طلا نزد فروشگاه)، منفی = بدهکار مشتری — جهتش برعکس ریاله
    // پرداخت طلا یعنی مشتری طلا به فروشگاه داده → همیشه به طلب مشتری اضافه می‌شه (بدون توجه به علامت فعلی)
    DB.cust[idx].debtGram = (DB.cust[idx].debtGram||0) + gram;
  }
  if(bankAccountId&&rial>0){
    const baIdx=(DB.bankAccounts||[]).findIndex(a=>a.id===bankAccountId);
    if(baIdx>=0) DB.bankAccounts[baIdx].balance=(+DB.bankAccounts[baIdx].balance||0)+rial;
  }
  DB.tx.unshift({id:Date.now(),date:today(),type:'payment',item:'پرداخت حساب',cust:c.name,paid:rial,paidGram:gram,note,total:0,balance:0,gv:0,wage:0,profit:0,vat:0,bankAccountId});
  save();closeModal();TAB='customers';showTab();
}

function onRetTypeChange(v){
  document.getElementById('ret-partial-fields').style.display = v==='partial' ? 'contents' : 'none';
}

function submitReturn(txId){
  const t=DB.tx.find(x=>x.id==txId);
  if(!t)return;
  const retType=document.getElementById('ret-type').value;
  const note=document.getElementById('ret-note').value||'';
  const isSell=t.type==='sell';
  const isBuy=t.type==='buy';

  let retW, retAmount;
  if(retType==='full'){
    retW = +t.w||0;
    retAmount = +t.total||0;
  } else {
    retW = +document.getElementById('ret-w').value||0;
    retAmount = +(document.getElementById('ret-amount').value||'').replace(/,/g,'')||0;
    if(!retW && !retAmount){alert('وزن یا مبلغ مرجوعی را وارد کنید');return;}
    if(retW<0 || retAmount<0){alert('وزن یا مبلغ مرجوعی نمی‌تواند منفی باشد');return;}
    if(retAmount>(+t.total||0)){alert('مبلغ مرجوعی نمی‌تواند از جمع کل تراکنش بیشتر باشد');return;}
    if(retW>(+t.w||0)){alert('وزن مرجوعی نمی‌تواند از وزن تراکنش بیشتر باشد');return;}
  }

  // آپدیت موجودی
  const retInvIdx = t.itemCode
    ? DB.inv.findIndex(i=>i.itemCode===t.itemCode)
    : DB.inv.findIndex(i=>i.item===t.item&&i.karat===t.karat&&!i.itemCode);
  if(isSell && retW>0){
    // فروش مرجوع شد → موجودی برمیگرده (اضافه میشه)
    if(retInvIdx>=0) DB.inv[retInvIdx].w=(+DB.inv[retInvIdx].w+retW).toFixed(3);
    else DB.inv.push({id:Date.now(),item:t.item,itemCode:t.itemCode,karat:t.karat,w:retW.toFixed(3)});
  } else if(isBuy && retW>0){
    // خرید مرجوع شد → موجودی کم میشه
    if(retInvIdx>=0){
      const nw=Math.max(0,+DB.inv[retInvIdx].w-retW);
      if(nw<=0) DB.inv.splice(retInvIdx,1);
      else DB.inv[retInvIdx].w=nw.toFixed(3);
    }
  }

  // آپدیت مانده مشتری
  const origW = +t.w||0;
  const ratio = origW>0 ? Math.min(1, retW/origW) : (retType==='full'?1:0);
  const wbalPortion = t.weightBal ? (+t.weightBal||0)*ratio : 0;
  if(t.cust){
    const cidx=DB.cust.findIndex(c=>c.name===t.cust);
    if(cidx>=0){
      if(isSell){
        // فروش مرجوع شد → بدهی مشتری کم میشه (چون دیگه بدهکار این مبلغ نیست)
        DB.cust[cidx].debtRial=(DB.cust[cidx].debtRial||0)-retAmount;
      } else if(isBuy){
        // خرید مرجوع شد → طلبی که به مشتری بدهکار بودیم کم میشه
        DB.cust[cidx].debtRial=(DB.cust[cidx].debtRial||0)+retAmount;
      }
      // اگه اون تراکنش، مانده وزنی (طلب/بدهی گرمی) هم داشته، به تناسب مرجوعی، مانده وزنی مشتری هم اصلاح میشه
      if(t.weightBal){
        if(isBuy){
          // خرید مرجوع شد → طلبِ گرمیِ مشتری (debtGram مثبت) که بابت این تراکنش بود، کم میشه
          DB.cust[cidx].debtGram=(DB.cust[cidx].debtGram||0)-wbalPortion;
        } else if(isSell){
          // فروش مرجوع شد → بدهیِ گرمیِ مشتری (debtGram منفی) که بابت این تراکنش بود، جبران میشه
          DB.cust[cidx].debtGram=(DB.cust[cidx].debtGram||0)+wbalPortion;
        }
      }
    }
  }

  // برگردوندن بخشی از مبلغ روی حساب بانکی لینک‌شده (اگه تراکنش اصلی به حسابی وصل بود)
  if(t.bankAccountId){
    const baIdx=(DB.bankAccounts||[]).findIndex(a=>a.id===t.bankAccountId);
    if(baIdx>=0){
      const refundAmt = Math.min(retAmount, +t.paid||0);
      if(refundAmt>0){
        const signed = isSell ? -refundAmt : refundAmt;
        DB.bankAccounts[baIdx].balance = (+DB.bankAccounts[baIdx].balance||0) + signed;
      }
    }
  }

  // ثبت تراکنش مرجوعی
  DB.tx.unshift({
    id:Date.now(), date:today(), type:'return',
    item:t.item+' (مرجوعی)', itemCode:t.itemCode,
    w:retW||'', karat:t.karat, cust:t.cust, phone:t.phone,
    note:`مرجوع از تراکنش ${typeLabelFa(t.type)} — ${note}`,
    total:retAmount, paid:retAmount, balance:0,
    gv:0,wage:0,profit:0,vat:0, refTx:t.id
  });

  // علامت‌گذاری تراکنش اصلی + آپدیت جمع‌کل/مانده/وزنِ خودِ همون تراکنش (تا کارت و فاکتورش هم درست بمونه)
  // مجموع مرجوعی‌های تجمعی رو هم جدا نگه می‌داریم تا اگه بعداً این تراکنش ویرایش شد، اثر مرجوعی از دست نره
  t.returnedTotal = (+t.returnedTotal||0) + retAmount;
  t.returnedW = (+t.returnedW||0) + (retW||0);
  const preRetTotal = +t.total||0;
  const fracReturned = preRetTotal>0 ? Math.min(1, retAmount/preRetTotal) : 0;
  t.gv = Math.round((+t.gv||0)*(1-fracReturned));
  t.wage = Math.round((+t.wage||0)*(1-fracReturned));
  t.profit = Math.round((+t.profit||0)*(1-fracReturned));
  t.vat = Math.round((+t.vat||0)*(1-fracReturned));
  t.total = Math.max(0, preRetTotal - retAmount);
  // مانده نباید صفر کلمپ بشه — اگه مبلغ برگشتی از مانده‌ی باقی‌مونده بیشتر بود (چون بخشی از این تراکنش قبلاً پرداخت شده بود)،
  // مانده منفی یعنی این تراکنش به‌تنهایی الان طلبِ مشتریه (باید بهش پس داده بشه) — این عدد باید دقیق بمونه
  t.balance = t.total - (+t.paid||0);
  if(retW>0) t.w = Math.max(0, (+t.w||0) - retW);
  if(t.weightBal) t.weightBal = Math.max(0, (+t.weightBal||0) - wbalPortion);
  if(retType==='full'){
    t.returned=true;
  } else {
    t.returned='partial';
  }

  save();closeModal();renderOther();
}

function typeLabelFa(t){
  return{buy:'خرید طلا',sell:'فروش',service:'خدمات',payment:'پرداخت',return:'مرجوعی',coinbuy:'خرید سکه',coinsell:'فروش سکه',swap:'معاوضه'}[t]||t;
}

function openCoinInvEdit(coinType){
  MODAL='editCoinInv'; MD={coinType}; renderModal();
}

function saveCoinInvEdit(coinType){
  const newQty = +_('coin-inv-edit-qty').value || 0;
  if(!DB.coinInv) DB.coinInv = [];
  const idx = DB.coinInv.findIndex(c=>c.type===coinType);
  if(idx>=0) DB.coinInv[idx].qty = newQty;
  else DB.coinInv.push({type: coinType, qty: newQty});
  save();
  closeModal();
  renderOther();
}

function saveKey(){
  apiKey=_('ak').value;localStorage.setItem('gkey',apiKey);
  const brsVal = _('brs-ak')?.value?.trim();
  if(brsVal!=null) localStorage.setItem('gold_brsapi_key', brsVal);
  closeModal();
}

function exportBackup(){
  const blob=new Blob([JSON.stringify({version:1,date:today(),db:DB},null,2)],{type:'application/json'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`gold-backup-${today().replace(/\//g,'-')}.json`;a.click();
}
function importBackup(file){
  if(!file)return;
  const r=new FileReader();
  r.onload=e=>{
    try{
      const data=JSON.parse(e.target.result);
      if(!data.db||!data.db.tx){alert('فایل معتبر نیست');return;}
      if(!confirm(`بازیابی از فایل ${data.date||''}؟\n${data.db.tx.length} تراکنش\nداده‌های فعلی پاک میشه`))return;
      DB={
        tx:data.db.tx||[], inv:data.db.inv||[], cust:data.db.cust||[], products:data.db.products||[],
        coinInv:data.db.coinInv||[], accessoryCatalog:data.db.accessoryCatalog||[], bankAccounts:data.db.bankAccounts||[]
      };
      save();alert('بازیابی موفق ✅');closeModal();TAB='dashboard';showTab();
    }catch(err){alert('خطا: '+err.message);}
  };r.readAsText(file);
}

// ══ اطلاعات فروشگاه (برای هدر/فوتر فاکتور چاپی) ══════════════════════════
const SHOP_INFO = {
  name: 'گالری فانوس',
  subtitle: 'Fanos Gallery · Gold & Jewel',
  phone: '۰۹۳۶۵۸۸۷۵۰۸',
  address: 'مشهد، بلوار سجاد، حدفاصل چهارراه بهار و بزرگمهر، پاساژ وصال، طبقه مثبت یک، پلاک ۲۱',
  instagram: '@gallery_fanos'
};
const SHOP_LOGO_B64 = "";

function invoiceHeaderHTML(t){
  return `
  <div class="inv-header">
    <img class="inv-logo" src="data:image/png;base64,${SHOP_LOGO_B64}" alt="logo">
    <div class="inv-shop-info">
      <div class="inv-shop-name">${SHOP_INFO.name}</div>
      <div class="inv-shop-sub">${SHOP_INFO.subtitle}</div>
      <div class="inv-shop-contact">📞 ${SHOP_INFO.phone} &nbsp;|&nbsp; 📸 ${SHOP_INFO.instagram}</div>
      <div class="inv-shop-contact">📍 ${SHOP_INFO.address}</div>
    </div>
  </div>
  <div class="inv-meta">
    <div><b>شماره فاکتور:</b> ${t.id}</div>
    <div><b>تاریخ:</b> ${t.date||'—'}</div>
  </div>
  <div class="inv-meta">
    <div><b>خریدار:</b> ${t.cust||'—'}</div>
    <div><b>شماره تماس:</b> ${t.phone||'—'}</div>
  </div>`;
}

function invoiceFooterHTML(){
  return `
  <div class="inv-note">توجه: در صورت فروش، اجرت ساخت کسر و طلا به نرخ روز خریداری خواهد شد.</div>
  <div class="inv-sign">
    <div class="inv-sign-box">مهر و امضاء فروشنده</div>
    <div class="inv-sign-box">امضاء خریدار</div>
  </div>
  <div class="footer">${SHOP_INFO.name} — با تشکر از خرید شما 🌹</div>`;
}

const INVOICE_STYLE = `
  body{font-family:Tahoma,sans-serif;padding:16px;font-size:12.5px;direction:rtl;color:#222}
  .inv-header{display:flex;align-items:center;justify-content:space-between;border-bottom:3px solid #c9a84c;padding-bottom:10px;margin-bottom:10px}
  .inv-logo{width:70px;height:auto}
  .inv-shop-info{text-align:left;flex:1;margin-right:12px}
  .inv-shop-name{font-size:20px;font-weight:800;color:#8a6d1f}
  .inv-shop-sub{font-size:11px;color:#999;margin-bottom:4px}
  .inv-shop-contact{font-size:11px;color:#555}
  .inv-meta{display:flex;justify-content:space-between;background:#faf7ee;border:1px solid #eadfb8;border-radius:6px;padding:6px 12px;margin-bottom:6px;font-size:12px}
  table.inv-table{width:100%;border-collapse:collapse;margin-top:10px;font-size:11px}
  table.inv-table th,table.inv-table td{border:1px solid #ccc;padding:6px 4px;text-align:center}
  table.inv-table th{background:#f2ecd8;font-weight:700}
  .inv-summary{margin-top:12px;background:#f9f9f9;border-radius:8px;padding:10px 14px}
  .inv-summary .row{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px dashed #ddd}
  .inv-summary .row:last-child{border-bottom:none}
  .inv-summary .grand{font-weight:800;font-size:15px;color:#8a6d1f;border-top:2px solid #c9a84c;margin-top:4px;padding-top:8px}
  .inv-note{font-size:10.5px;color:#999;margin-top:10px;text-align:center}
  .inv-sign{display:flex;justify-content:space-between;margin-top:26px}
  .inv-sign-box{width:45%;text-align:center;border-top:1px solid #999;padding-top:6px;font-size:11px;color:#555}
  .footer{text-align:center;color:#999;font-size:11px;margin-top:16px}
`;

function printTx(id){
  const t=DB.tx.find(x=>x.id==id);
  if(!t)return;
  const w=window.open('','_blank','width=440,height=700');
  if(!w){alert('⚠️ پنجره‌ی چاپ باز نشد — احتمالاً مرورگر جلوی پاپ‌آپ رو گرفته.\nاز تنظیمات مرورگر، «باز شدن پنجره‌های جدید» رو برای این سایت فعال کن و دوباره امتحان کن.');return;}

  if(t.type==='sell'||t.type==='buy'||t.type==='service'){
    const isBuy=t.type==='buy', isService=t.type==='service';
    const accRows=(t.accessories||[]).map(a=>`<tr><td colspan="4">🔗 ${a.name||'متعلقات'}</td><td colspan="5">${(+a.price||0).toLocaleString('fa-IR')} ت</td></tr>`).join('');
    const mainRow = isService
      ? `<tr><td>۱</td><td>—</td><td>${t.item}</td><td colspan="6">${(+t.sfee||0).toLocaleString('fa-IR')} ت</td></tr>`
      : `<tr>
          <td>۱</td>
          <td>${t.itemCode||'—'}</td>
          <td>${t.item}</td>
          <td>${t.karat||'—'}</td>
          <td>${t.w||'—'}</td>
          <td>${(+t.ppg||0).toLocaleString('fa-IR')}</td>
          <td>${(+t.gv||0).toLocaleString('fa-IR')}</td>
          <td>${(+t.wage||0).toLocaleString('fa-IR')}</td>
          <td>${(+t.profit||0).toLocaleString('fa-IR')}</td>
        </tr>`;
    const tableHead = isService ? '' : `
      <thead><tr>
        <th>ردیف</th><th>کد کالا</th><th>شرح کالا</th><th>عیار</th><th>وزن (گرم)</th>
        <th>قیمت هر گرم</th><th>ارزش طلا</th><th>اجرت ساخت</th><th>سود</th>
      </tr></thead>`;
    w.document.write(`<!DOCTYPE html><html dir="rtl"><head><meta charset="UTF-8"><style>${INVOICE_STYLE}</style></head>
    <body>
    ${invoiceHeaderHTML(t)}
    <table class="inv-table">
      ${tableHead}
      <tbody>${mainRow}${accRows}</tbody>
    </table>
    <div class="inv-summary">
      ${t.accTotal?`<div class="row"><span>جمع متعلقات</span><span>${(+t.accTotal).toLocaleString('fa-IR')} ت</span></div>`:''}
      ${!isService&&t.vat?`<div class="row"><span>مالیات و عوارض ارزش‌افزوده</span><span>${(+t.vat).toLocaleString('fa-IR')} ت</span></div>`:''}
      <div class="row grand"><span>جمع کل فاکتور</span><span>${(+t.total||0).toLocaleString('fa-IR')} تومان</span></div>
      ${t.paid>0?`<div class="row" style="color:green"><span>پرداخت شده</span><span>${(+t.paid).toLocaleString('fa-IR')} ت</span></div>`:''}
      ${t.balance>0?`<div class="row" style="color:#c00"><span>مانده</span><span>${(+t.balance).toLocaleString('fa-IR')} ت</span></div>`:''}
      ${t.balance<0?`<div class="row" style="color:#06c"><span>طلب مشتری (اضافه‌پرداخت)</span><span>${Math.abs(+t.balance).toLocaleString('fa-IR')} ت</span></div>`:''}
      ${t.bankAccountId?`<div class="row"><span>🏦 حساب</span><span>${(DB.bankAccounts||[]).find(a=>a.id===t.bankAccountId)?.name||''}</span></div>`:''}
      ${t.note?`<div class="row"><span>یادداشت</span><span>${t.note}</span></div>`:''}
    </div>
    ${invoiceFooterHTML()}
    </body></html>`);
  } else {
    // انواع دیگه (سکه، معاوضه، پرداخت، مرجوعی، بانک) — فرمت ساده‌تر، همراه با هدر برند فروشگاه
    w.document.write(`<!DOCTYPE html><html dir="rtl"><head><meta charset="UTF-8"><style>${INVOICE_STYLE}
    .row{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid #eee}
    .label{color:#666}.val{font-weight:bold}
    .total{background:#f5f5f5;padding:10px;border-radius:6px;margin-top:10px;text-align:center;font-size:16px;font-weight:bold}
    </style></head>
    <body>
    ${invoiceHeaderHTML(t)}
    <h3 style="text-align:center;margin:10px 0">${typeLabelFa(t.type)}</h3>
    <div class="row"><span class="label">شرح:</span><span class="val">${t.item}${t.itemCode?' (#'+t.itemCode+')':''}</span></div>
    ${t.w?`<div class="row"><span class="label">وزن:</span><span class="val">${t.w} گرم</span></div>`:''}
    ${t.paidGram?`<div class="row"><span class="label">طلای تحویلی:</span><span class="val">${t.paidGram} گرم</span></div>`:''}
    ${t.amount?`<div class="row"><span class="label">مبلغ:</span><span class="val">${(+t.amount).toLocaleString('fa-IR')} ت</span></div>`:''}
    ${t.bankAccountId||t.accountId?`<div class="row"><span class="label">🏦 حساب:</span><span class="val">${(DB.bankAccounts||[]).find(a=>a.id===(t.bankAccountId||t.accountId))?.name||''}</span></div>`:''}
    ${t.thirdPartyName?`<div class="row"><span class="label">شخص ثالث:</span><span class="val">${t.thirdPartyName}</span></div>`:''}
    <div class="total">جمع کل: ${(+(t.type==='payment'?t.paid:t.total)||0).toLocaleString('fa-IR')} تومان</div>
    ${t.note?`<div style="margin-top:10px;color:#666;font-size:12px">یادداشت: ${t.note}</div>`:''}
    ${invoiceFooterHTML()}
    </body></html>`);
  }
  w.document.close();
  setTimeout(()=>w.print(),500);
}

function printCustStatement(custId){
  const c=DB.cust.find(x=>x.id==custId);if(!c)return;
  const ctx=DB.tx.filter(t=>t.cust===c.name).sort((a,b)=>jCmp(a.date,b.date));
  const rows=ctx.map(t=>`<tr>
    <td>${t.date}</td><td>${typeLabelFa(t.type)}</td><td>${t.item}</td>
    <td>${t.w?t.w+' گ':'—'}</td>
    <td style="color:${t.type==='sell'?'#c00':'#080'}">${(+(t.type==='service'?t.sfee:t.type==='payment'?t.paid:t.total)||0).toLocaleString('fa-IR')}</td>
  </tr>`).join('');
  const w=window.open('','_blank');
  if(!w){alert('⚠️ پنجره‌ی چاپ باز نشد — احتمالاً مرورگر جلوی پاپ‌آپ رو گرفته.\nاز تنظیمات مرورگر، «باز شدن پنجره‌های جدید» رو برای این سایت فعال کن و دوباره امتحان کن.');return;}
  w.document.write(`<!DOCTYPE html><html dir="rtl"><head><meta charset="UTF-8">
  <style>${INVOICE_STYLE}
  table{width:100%;border-collapse:collapse;margin-top:15px}
  th,td{border:1px solid #ccc;padding:6px;text-align:center;font-size:11px}
  th{background:#f0f0f0}
  .summary{display:flex;justify-content:space-around;margin-top:20px;background:#f5f5f5;padding:15px;border-radius:8px}
  .box{text-align:center}.box b{font-size:16px;display:block;margin-top:4px}</style></head>
  <body>
  ${invoiceHeaderHTML({date:today(),cust:c.name,phone:c.phone,id:'—'})}
  <h3 style="text-align:center;margin:10px 0">🧾 صورتحساب مشتری</h3>
  <table><thead><tr><th>تاریخ</th><th>نوع</th><th>کالا</th><th>وزن</th><th>مبلغ (ت)</th></tr></thead>
  <tbody>${rows||'<tr><td colspan="5">تراکنشی ثبت نشده</td></tr>'}</tbody></table>
  <div class="summary">
    <div class="box">مانده ریالی<b style="color:${(c.debtRial||0)>0?'#c00':((c.debtRial||0)<0?'#06c':'#080')}">${(c.debtRial||0)>0?fmt(c.debtRial)+' (بدهکار)':((c.debtRial||0)<0?fmt(Math.abs(c.debtRial))+' (بستانکار)':'تسویه')}</b></div>
    <div class="box">مانده طلایی<b style="color:${(c.debtGram||0)>0?'#06c':((c.debtGram||0)<0?'#c00':'#080')}">${(c.debtGram||0)!==0?fmtG(Math.abs(c.debtGram))+((c.debtGram||0)>0?' (بستانکار)':' (بدهکار)'):'تسویه'}</b></div>
  </div>
  ${invoiceFooterHTML()}
  </body></html>`);
  w.document.close();setTimeout(()=>w.print(),500);
}

function exportCSV(){
  const h='تاریخ,نوع,کالا,کد,گرم,عیار,قیمت هر گرم,ارزش طلا,اجرت,سود,مالیات,قیمت نهایی,پرداخت,مانده,مشتری,تلفن,یادداشت\n';
  const rows=DB.tx.map(t=>[t.date,{buy:'خرید طلا',sell:'فروش',service:'خدمات',payment:'پرداخت',return:'مرجوعی'}[t.type]||'',t.item||'',t.itemCode||'',t.w||'',t.karat||'',t.ppg||'',t.gv||'',t.wage||'',t.profit||'',t.vat||'',t.total||'',t.paid||'',t.balance||'',t.cust||'',t.phone||'',t.note||''].join(',')).join('\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\uFEFF'+h+rows],{type:'text/csv;charset=utf-8;'}));a.download='حسابداری_طلا.csv';a.click();
}

