_('hdr').innerHTML=`
<div style="background:#141414;border-bottom:1px solid #2a2a2a;padding:12px 16px;display:flex;align-items:center;justify-content:space-between">
  <div style="display:flex;align-items:center;gap:8px">
    <span style="font-size:20px">💍</span>
    <div><div style="color:#c9a84c;font-weight:800;font-size:15px">دستیار طلافروشی</div><div style="color:#444;font-size:10px">حسابداری هوشمند · v2.7</div></div>
  </div>
  <div class="row" style="gap:6px">
    <button class="btn" onclick="openModal('report')" style="background:#1a1a3a;color:#a78bfa;font-size:11px;padding:7px 10px">📊 گزارش</button>
    <button class="btn" onclick="exportCSV()" style="background:#1a2a1a;color:#4ade80;font-size:11px;padding:7px 10px">↓ Excel</button>
    <button class="btn" onclick="openModal('backup')" style="background:#1a2a2a;color:#2dd4bf;font-size:11px;padding:7px 10px">💾</button>
    <button class="btn" onclick="openModal('settings')" style="background:#1a1a2a;color:#60a5fa;font-size:11px;padding:7px 10px">⚙️</button>
  </div>
</div>`;

_('tabs').innerHTML=[['dashboard','📊 داشبورد'],['new','➕ ثبت'],['coin','🪙 سکه'],['swap','🔄 معاوضه'],['bank','🏦 بانک'],['transactions','📋 تراکنش‌ها'],['customers','👤 مشتریان'],['products','🏷️ محصولات']].map(([t,l])=>`<button class="tab" data-t="${t}" onclick="setTab('${t}')">${l}</button>`).join('');

document.addEventListener('keydown',e=>{
  if(e.key==='Escape'&&MODAL)closeModal();
});
document.addEventListener('click',e=>{
  if(!e.target.closest('#f-cust')&&!e.target.closest('#cust-drop')){const el=_('cust-drop');if(el)el.innerHTML='';}
  if(!e.target.closest('#quick-inp')&&!e.target.closest('#quick-drop')){const el=_('quick-drop');if(el)el.innerHTML='';}
});

setType('sell');
showTab();
</script>
